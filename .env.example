# Copy to .env.local (Windows: copy .env.example .env.local) and fill in. Never commit .env.local.
# In production, set the same names in Vercel → Project → Settings → Environment Variables.

# ── Merchant portal (/merchant) ─────────────────────────────
# Starter password for the first login. The portal forces you to choose your own, which is then stored
# only as a scrypt hash in private storage; after that this value is no longer used.
MERCHANT_BOOTSTRAP_PASSWORD=
# 32+ random characters used to sign login cookies. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── Paystack (server-side only; NOT a VITE_ variable) ───────
# Test key: sk_test_… (try everything with Paystack test cards). Live key: sk_live_… (real money).
# Leave empty locally to use the built-in MOCK payment page.
PAYSTACK_SECRET_KEY=

# ── Storage (S3). Leave empty locally: files are kept in .local-data/ ──
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional: a CloudFront/custom domain that serves the bucket's images/ folder
S3_PUBLIC_BASE_URL=

# Public origin used in invoice links and as Paystack's callback (no trailing slash)
PUBLIC_BASE_URL=https://jays-bistro.vercel.app

# ── AI concierge (browser-exposed until it moves behind the API; restrict this key) ──
VITE_GEMINI_API_KEY=
