{
  "rewrites": [{ "source": "/((?!api/|menu/|assets/).*)", "destination": "/index.html" }],
  "headers": [
    { "source": "/menu/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }] },
    { "source": "/api/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }] }
  ]
}
