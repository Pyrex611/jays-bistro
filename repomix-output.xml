<file path="src/lib/menuDoc.js">
import { CATEGORIES, MENU_ITEMS } from "../data/menu.js";
import { HERO_ITEM_IDS, SUBHERO_ITEM_IDS } from "../data/layout.js";
import { PHOTOS } from "../data/photos.js";
import { DEFAULT_ICON, ICON_KEYS } from "./categoryIcons.js";
import { DEFAULT_SETTINGS, normalizeSettings } from "./settings.js";

/**
 * The menu document: the single JSON object the merchant edits and the storefront reads.
 *   { version, updatedAt, categories[], items[], layout:{heroIds[], subheroIds[]}, settings }
 * Validation here runs on the server (authoritative) and in the portal (instant feedback).
 */

export const LIMITS = { name: 80, description: 280, maxPrice: 10_000_000, maxHero: 12, maxSubhero: 2, maxItems: 500 };

export function defaultMenuDoc() {
  return {
    version: 0,
    updatedAt: null,
    categories: CATEGORIES.map((c) => ({ ...c })),
    items: MENU_ITEMS.map((i) => ({ ...i, ...(PHOTOS[i.id] ? { image: PHOTOS[i.id].url, imageStyle: "photo" } : {}) })),
    layout: { heroIds: [...HERO_ITEM_IDS], subheroIds: [...SUBHERO_ITEM_IDS] },
    settings: normalizeSettings({}),
  };
}

export const nextItemId = (items) => items.reduce((max, i) => Math.max(max, i.id), 0) + 1;

const isSafeImage = (src) => typeof src === "string" && src.length <= 600 && /^(https:\/\/|menu\/|uploads\/|\/__local\/images\/)/.test(src);
const isPlainString = (v) => typeof v === "string";

/**
 * @returns {{ ok: true, doc: object } | { ok: false, errors: string[] }}
 */
export function validateMenuDoc(input) {
  const errors = [];
  if (!input || typeof input !== "object") return { ok: false, errors: ["Menu must be an object"] };

  // categories
  const rawCats = Array.isArray(input.categories) ? input.categories : [];
  if (rawCats.length === 0) errors.push("At least one category is required");
  const seenCats = new Set();
  const categories = rawCats.map((c, i) => {
    const name = isPlainString(c?.name) ? c.name.trim() : "";
    if (name.length < 2 || name.length > 30) errors.push(`Category ${i + 1}: name must be 2–30 characters`);
    if (seenCats.has(name.toLowerCase())) errors.push(`Category "${name}" is duplicated`);
    seenCats.add(name.toLowerCase());
    return { name, icon: ICON_KEYS.includes(c?.icon) ? c.icon : DEFAULT_ICON };
  });

  // items
  const rawItems = Array.isArray(input.items) ? input.items : [];
  if (rawItems.length > LIMITS.maxItems) errors.push(`Too many items (max ${LIMITS.maxItems})`);
  const seenIds = new Set();
  const items = rawItems.map((it, i) => {
    const label = `Item ${i + 1}${it?.name ? ` (${it.name})` : ""}`;
    const id = Number(it?.id);
    if (!Number.isInteger(id) || id < 1) errors.push(`${label}: invalid id`);
    if (seenIds.has(id)) errors.push(`${label}: duplicate id ${id}`);
    seenIds.add(id);

    const name = isPlainString(it?.name) ? it.name.trim() : "";
    if (name.length < 2 || name.length > LIMITS.name) errors.push(`${label}: name must be 2–${LIMITS.name} characters`);

    const price = Number(it?.price);
    if (!Number.isInteger(price) || price < 1 || price > LIMITS.maxPrice) errors.push(`${label}: price must be a whole number of naira (1–${LIMITS.maxPrice})`);

    const description = isPlainString(it?.description) ? it.description.trim() : "";
    if (description.length > LIMITS.description) errors.push(`${label}: description is over ${LIMITS.description} characters`);

    if (!seenCats.has(String(it?.category ?? "").trim().toLowerCase())) errors.push(`${label}: unknown category "${it?.category}"`);
    if (!isSafeImage(it?.image)) errors.push(`${label}: image must be an https URL or a path under menu/ or uploads/`);

    return {
      id,
      category: String(it?.category ?? "").trim(),
      name,
      price,
      description,
      image: it?.image,
      imageStyle: it?.imageStyle === "cutout" ? "cutout" : "photo",
      featured: Boolean(it?.featured),
      isActive: it?.isActive !== false,
      isAvailable: it?.isAvailable !== false,
    };
  });

  // layout (unknown ids are dropped silently — an item may have been deleted)
  const ids = new Set(items.map((i) => i.id));
  const clean = (arr, max) => [...new Set((Array.isArray(arr) ? arr : []).map(Number))].filter((id) => ids.has(id)).slice(0, max);
  const heroIds = clean(input.layout?.heroIds, LIMITS.maxHero);
  const subheroIds = clean(input.layout?.subheroIds, LIMITS.maxSubhero);

  if (errors.length) return { ok: false, errors };

  return {
    ok: true,
    doc: {
      version: Number.isInteger(input.version) ? input.version : 0,
      updatedAt: input.updatedAt ?? null,
      categories,
      items,
      layout: { heroIds, subheroIds },
      settings: normalizeSettings(input.settings),
    },
  };
}
</file>

<file path="src/lib/pricing.js">
/**
 * Order pricing — ONE implementation shared by the storefront (display) and the API (authoritative).
 * Money is integer naira. Paystack wants kobo: use toKobo().
 */

export const toKobo = (naira) => Math.round(Number(naira) * 100);

/** Online-payment fee line. `flat` only applies from `flatWaivedBelow` upwards (mirrors Paystack's local-card structure; editable). */
export function computeServiceFee(base, cfg) {
  if (!cfg?.enabled || base <= 0) return 0;
  let fee = (base * cfg.percent) / 100 + (base >= cfg.flatWaivedBelow ? cfg.flat : 0);
  fee = Math.round(fee);
  return cfg.cap > 0 ? Math.min(fee, cfg.cap) : fee;
}

export const activeZones = (settings) => (settings.zones ?? []).filter((z) => z.enabled);

/**
 * @param {Array<{unitPrice:number, quantity:number}>} lines
 * @param {"pickup"|"delivery"} fulfilment
 * @param {object} settings  normalised settings
 * @param {{ zoneId?: string|null, payOnline?: boolean }} [options]
 */
export function computeTotals(lines, fulfilment, settings, { zoneId = null, payOnline = false } = {}) {
  const subtotal = lines.reduce((sum, l) => sum + l.unitPrice * l.quantity, 0);
  const delivery = fulfilment === "delivery";
  const zones = activeZones(settings);
  const zone = delivery && zones.length ? zones.find((z) => z.id === zoneId) ?? null : null;
  const zoneRequired = delivery && zones.length > 0 && !zone;

  let deliveryFee = 0;
  let freeDelivery = false;
  if (delivery) {
    deliveryFee = zones.length ? zone?.fee ?? 0 : settings.deliveryFee;
    if (settings.freeDeliveryAbove > 0 && subtotal >= settings.freeDeliveryAbove) {
      freeDelivery = deliveryFee > 0;
      deliveryFee = 0;
    }
  }

  const serviceFee = payOnline ? computeServiceFee(subtotal + deliveryFee, settings.serviceFee) : 0;
  const minOrder = Math.max(settings.minOrder, zone?.minOrder ?? 0);

  return {
    subtotal,
    deliveryFee,
    serviceFee,
    total: subtotal + deliveryFee + serviceFee,
    zone,
    zoneRequired,
    freeDelivery,
    minOrder,
    belowMinimum: subtotal < minOrder,
    shortBy: Math.max(0, minOrder - subtotal),
  };
}
</file>

<file path="src/lib/receipt.js">
/** Display helpers for invoices and receipts. Pure. */

const CHANNELS = { card: "Card", bank: "Bank", bank_transfer: "Bank transfer", ussd: "USSD", qr: "QR", mobile_money: "Mobile money", eft: "EFT", apple_pay: "Apple Pay", test: "Test payment" };
/** Receipts from mock/test payments are stamped TEST. */
export const isTestMode = (mode) => mode === "mock" || mode === "test" || mode === "demo";

export const channelLabel = (channel) => CHANNELS[channel] ?? (channel ? String(channel).replaceAll("_", " ") : "Online");

export function formatLagosDateTime(iso) {
  const d = new Date(iso);
  const date = new Intl.DateTimeFormat("en-NG", { timeZone: "Africa/Lagos", day: "numeric", month: "short", year: "numeric" }).format(d);
  const time = new Intl.DateTimeFormat("en-NG", { timeZone: "Africa/Lagos", hour: "numeric", minute: "2-digit", hour12: true }).format(d);
  return { date, time: time.toUpperCase(), full: `${date}, ${time.toUpperCase()}` };
}

/** "23h 12m" / "12m" / null when already expired. */
export function timeLeft(expiresAt, now = Date.now()) {
  const ms = new Date(expiresAt).getTime() - now;
  if (ms <= 0) return null;
  const mins = Math.floor(ms / 60_000);
  const h = Math.floor(mins / 60);
  const m = mins % 60;
  return h > 0 ? `${h}h ${m}m` : `${Math.max(m, 1)}m`;
}
