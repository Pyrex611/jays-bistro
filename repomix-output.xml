import crypto from "node:crypto";
import { promisify } from "node:util";
import { getStorage } from "./storage.js";
import { fail, isHttps, isProduction, parseCookies } from "./http.js";
export { validateNewPassword } from "../../src/lib/password.js";

/**
 * Merchant password lock — no auth provider, no user accounts.
 *
 *   • The password is never stored in plain text. A scrypt hash lives in a PRIVATE storage object (config/merchant.json).
 *   • Login happens on the server: it reads that object, compares in constant time, and answers with a signed,
 *     HttpOnly, SameSite=Strict cookie. The browser never sees the hash and cannot "check" anything itself.
 *   • Until the merchant sets their own password, the one in env MERCHANT_BOOTSTRAP_PASSWORD works and the portal
 *     forces a change on first login. Changing the password signs everyone else out (the session carries a hash fingerprint).
 *   • Brute force: 5 failures per IP per 15 minutes, plus a fixed delay on every attempt.
 */

const scrypt = promisify(crypto.scrypt);
const RECORD_KEY = "config/merchant.json";
export const COOKIE = "jb_merchant";
export const SESSION_TTL_MS = 12 * 60 * 60 * 1000;
const WINDOW_MS = 15 * 60 * 1000;
const MAX_FAILS = 5;

const digest = (s) => crypto.createHash("sha256").update(String(s)).digest();
const safeEqual = (a, b) => crypto.timingSafeEqual(digest(a), digest(b));
const b64url = (buf) => Buffer.from(buf).toString("base64url");

export async function hashPassword(password) {
  const salt = crypto.randomBytes(16);
  const params = { N: 16384, r: 8, p: 1 };
  const hash = await scrypt(password, salt, 32, params);
  return { algo: "scrypt", ...params, salt: salt.toString("base64"), hash: hash.toString("base64") };
}

export async function verifyPassword(password, rec) {
  const hash = await scrypt(password, Buffer.from(rec.salt, "base64"), 32, { N: rec.N, r: rec.r, p: rec.p });
  const expected = Buffer.from(rec.hash, "base64");
  return hash.length === expected.length && crypto.timingSafeEqual(hash, expected);
}

let recordCache = { at: 0, value: null };
async function loadRecord(force = false) {
  if (!force && Date.now() - recordCache.at < 15_000) return recordCache.value;
  const value = await getStorage().getJSON(RECORD_KEY);
  recordCache = { at: Date.now(), value };
  return value;
}
export const resetAuthCacheForTests = () => (recordCache = { at: 0, value: null });

const fingerprint = (rec) => (rec ? digest(rec.hash).toString("hex").slice(0, 16) : "bootstrap");

/** @returns {Promise<{ok:boolean, bootstrap?:boolean, pwv?:string, reason?:string}>} */
export async function authenticate(password) {
  const rec = await loadRecord();
  if (rec) return (await verifyPassword(password, rec)) ? { ok: true, bootstrap: false, pwv: fingerprint(rec) } : { ok: false };
  const bootstrap = process.env.MERCHANT_BOOTSTRAP_PASSWORD;
  if (!bootstrap) return { ok: false, reason: "not_configured" };
  return safeEqual(password, bootstrap) ? { ok: true, bootstrap: true, pwv: "bootstrap" } : { ok: false };
}

export async function setPassword(newPassword) {
  const rec = { ...(await hashPassword(newPassword)), updatedAt: new Date().toISOString() };
  await getStorage().putJSON(RECORD_KEY, rec);
  recordCache = { at: Date.now(), value: rec };
  return { pwv: fingerprint(rec) };
}

// ── sessions ────────────────────────────────────────────────
function secret() {
  const s = process.env.SESSION_SECRET;
  if (s && s.length >= 32) return s;
  if (isProduction()) throw new Error("SESSION_SECRET must be set (32+ random characters).");
  return "dev-only-session-secret-change-me-0123456789";
}
const sign = (payload) => crypto.createHmac("sha256", secret()).update(payload).digest();

export function issueToken({ pwv, bootstrap }, now = Date.now()) {
  const payload = b64url(JSON.stringify({ exp: now + SESSION_TTL_MS, pwv, bootstrap: Boolean(bootstrap) }));
  return `${payload}.${b64url(sign(payload))}`;
}

export function readToken(token, now = Date.now()) {
  const [payload, mac] = String(token ?? "").split(".");
  if (!payload || !mac) return null;
  const expected = sign(payload);
  const given = Buffer.from(mac, "base64url");
  if (given.length !== expected.length || !crypto.timingSafeEqual(given, expected)) return null;
  try {
    const data = JSON.parse(Buffer.from(payload, "base64url").toString());
    return data.exp > now ? data : null;
  } catch {
    return null;
  }
}

export function cookieHeader(req, token, maxAgeSec = SESSION_TTL_MS / 1000) {
  const parts = [`${COOKIE}=${token}`, "Path=/api", "HttpOnly", "SameSite=Strict", `Max-Age=${maxAgeSec}`];
  if (isHttps(req) || isProduction()) parts.push("Secure");
  return parts.join("; ");
}
export const clearCookieHeader = (req) => cookieHeader(req, "", 0);

/** Returns the session payload, or null. Also rejects sessions issued before the last password change. */
export async function getSession(req) {
  const data = readToken(parseCookies(req)[COOKIE]);
  if (!data) return null;
  const rec = await loadRecord();
  if (data.pwv !== fingerprint(rec)) return null;
  if (!rec && !process.env.MERCHANT_BOOTSTRAP_PASSWORD) return null;
  return data;
}

/** Use at the top of every protected handler. Sends 401 and returns null when not signed in. */
export async function requireMerchant(req, res) {
  const session = await getSession(req);
  if (!session) {
    fail(res, 401, "Please sign in.");
    return null;
  }
  return session;
}

// ── brute-force throttle ─────────────────────────────────────
const attemptKey = (ip) => `config/attempts/${digest(ip).toString("hex").slice(0, 32)}.json`;

export async function throttleStatus(ip, now = Date.now()) {
  const rec = (await getStorage().getJSON(attemptKey(ip))) ?? { fails: [] };
  const fails = rec.fails.filter((t) => now - t < WINDOW_MS);
  const locked = fails.length >= MAX_FAILS;
  return { locked, retryAfter: locked ? Math.ceil((fails[0] + WINDOW_MS - now) / 1000) : 0, fails };
}
export async function recordFailure(ip, now = Date.now()) {
  const { fails } = await throttleStatus(ip, now);
  await getStorage().putJSON(attemptKey(ip), { fails: [...fails, now] });
}
export const clearFailures = (ip) => getStorage().remove(attemptKey(ip));
</file>

<file path="api/_lib/invoices.js">
import crypto from "node:crypto";
import { getStorage } from "./storage.js";
import { applyAttempt, buildInvoiceRecord, buildReceipt, isExpired as isExpiredModel, INVOICE_TTL_MS as TTL } from "../../src/lib/invoiceModel.js";
export { normalizePhone, validateCustomer } from "../../src/lib/customer.js";

/**
 * Invoice → receipt lifecycle.
 *
 *   invoices/pending/<id>.json        created at checkout / WhatsApp; expires after 24h (S3 lifecycle rule deletes it after 3 days)
 *   receipts/<yyyy>/<mm>/<id>.json    written when Paystack confirms payment; kept for the merchant's records
 *
 * The same URL (/invoice/<id>) shows the invoice while pending and the receipt once paid.
 * The id is 80 random bits, so the link itself is the access token.
 */

export const INVOICE_TTL_MS = TTL;
const ID_RE = /^\d{8}[a-z2-7]{16}$/;
const B32 = "abcdefghijklmnopqrstuvwxyz234567";

export const isValidId = (id) => typeof id === "string" && ID_RE.test(id);
export const pendingKey = (id) => `invoices/pending/${id}.json`;
export const receiptKey = (id) => `receipts/${id.slice(0, 4)}/${id.slice(4, 6)}/${id}.json`;
export const invoiceCode = (id) => `JB-${id.slice(8, 13).toUpperCase()}`;
export const referenceFor = (id, attempt) => `${id}-${attempt}`;
export const idFromReference = (ref) => String(ref ?? "").slice(0, String(ref ?? "").lastIndexOf("-"));

export function newInvoiceId(now = new Date()) {
  const date = now.toISOString().slice(0, 10).replaceAll("-", "");
  const bytes = crypto.randomBytes(16);
  return date + Array.from(bytes, (b) => B32[b & 31]).join("");
}

/** @param {{ lines: Array<{item:object, quantity:number}>, fulfilment: string, channel: string, settings: object, zoneId?: string, customer?: object }} input */
export function buildInvoice(input, now = new Date()) {
  const id = newInvoiceId(now);
  return buildInvoiceRecord({ ...input, id, code: invoiceCode(id), now });
}

export const isExpired = isExpiredModel;

export async function saveInvoice(record) {
  await getStorage().putJSON(pendingKey(record.id), record);
}

/** @returns {Promise<object|null>} the receipt if paid, else the pending invoice, else null */
export async function loadInvoice(id) {
  if (!isValidId(id)) return null;
  const storage = getStorage();
  return (await storage.getJSON(receiptKey(id))) ?? (await storage.getJSON(pendingKey(id)));
}

/** Re-prices an invoice for a chosen fulfilment/zone and registers a new payment attempt. Mutates and returns `record`. */
export function addAttempt(record, input, now = new Date()) {
  return applyAttempt(record, { ...input, reference: referenceFor(record.id, record.attempts.length + 1), now });
}

/**
 * Turn a verified Paystack payment into a receipt. Idempotent: webhook and browser callback may both call it.
 * Returns the receipt, or null if the verification does not match what we asked Paystack to charge.
 */
export async function settle(record, reference, verification, { mode = "live" } = {}) {
  const receipt = buildReceipt(record, reference, verification, mode);
  if (!receipt) return null;
  if (record.status === "paid") return record;
  const storage = getStorage();
  await storage.putJSON(receiptKey(record.id), receipt);
  await storage.remove(pendingKey(record.id));
  return receipt;
}
</file>

<file path="api/_lib/paystack.js">
import { isProduction } from "./http.js";

/**
 * Paystack integration (hosted redirect checkout).
 *   initialize → returns authorization_url → customer pays on Paystack → redirected to callback_url
 *   verify     → server-side confirmation (the ONLY thing we trust; never the redirect or webhook payload)
 *
 * Modes:
 *   test — PAYSTACK_SECRET_KEY is an sk_test_… key: real Paystack, test money (receipts stamped TEST, excluded from sales KPIs)
 *   live — PAYSTACK_SECRET_KEY is an sk_live_… key: real money
 *   mock — no key AND not production: lets you click through the whole flow locally / on previews
 *   off  — no key in production: checkout answers "payments not configured"
 */

const API = "https://api.paystack.co";

export const paystackMode = () => {
  const key = process.env.PAYSTACK_SECRET_KEY;
  if (key) return key.startsWith("sk_test_") ? "test" : "live"; // "test" = real Paystack, test money: receipts are stamped TEST
  return isProduction() ? "off" : "mock";
};
/** True when we really talk to Paystack (test or live key). */
export const isRealPaystack = (mode = paystackMode()) => mode === "live" || mode === "test";

async function call(path, init = {}) {
  const controller = new AbortController();
  const timer = setTimeout(() => controller.abort(), 12_000);
  try {
    const res = await fetch(`${API}${path}`, {
      ...init,
      signal: controller.signal,
      headers: { Authorization: `Bearer ${process.env.PAYSTACK_SECRET_KEY}`, "Content-Type": "application/json", ...(init.headers ?? {}) },
    });
    const json = await res.json().catch(() => ({}));
    if (!res.ok || json.status === false) throw new Error(json.message || `Paystack error ${res.status}`);
    return json.data;
  } finally {
    clearTimeout(timer);
  }
}

export async function initializeTransaction({ email, amountKobo, reference, callbackUrl, metadata }) {
  const mode = paystackMode();
  if (mode === "off") throw Object.assign(new Error("Online payment is not configured yet"), { code: "payments_off" });
  if (mode === "mock") {
    const sep = callbackUrl.includes("?") ? "&" : "?";
    return { authorizationUrl: `${callbackUrl}${sep}reference=${encodeURIComponent(reference)}&mock=success`, reference, mock: true };
  }
  const data = await call("/transaction/initialize", {
    method: "POST",
    body: JSON.stringify({ email, amount: amountKobo, currency: "NGN", reference, callback_url: callbackUrl, metadata }),
  });
  return { authorizationUrl: data.authorization_url, reference: data.reference ?? reference, mock: false };
}

/**
 * @returns {Promise<{ status: string, amountKobo?: number, currency?: string, channel?: string, paidAt?: string }>}
 * `status` is Paystack's own: "success" | "abandoned" | "failed" | "pending" | …
 */
export async function verifyTransaction(reference, { mockApproved = false, mockAmountKobo } = {}) {
  const mode = paystackMode();
  if (mode === "mock") {
    return mockApproved
      ? { status: "success", amountKobo: mockAmountKobo, currency: "NGN", channel: "test", paidAt: new Date().toISOString() }
      : { status: "pending" };
  }
  if (mode === "off") return { status: "pending" };
  try {
    const d = await call(`/transaction/verify/${encodeURIComponent(reference)}`);
    return { status: d.status, amountKobo: d.amount, currency: d.currency, channel: d.channel, paidAt: d.paid_at ?? d.paidAt };
  } catch (e) {
    // "Transaction reference not found" just means the customer never reached the payment step.
    if (/not found/i.test(e.message)) return { status: "pending" };
    throw e;
  }
}
</file>

<file path="api/_lib/storage.js">
import fs from "node:fs/promises";
import path from "node:path";

/**
 * Storage abstraction. One tiny interface, three drivers:
 *   s3     — production (private bucket; only images/* is public)
 *   fs     — local development (.local-data/, git-ignored)
 *   memory — unit tests
 *
 * Interface: getJSON(key) · putJSON(key, obj) · remove(key) · list(prefix, max) · putBinary(key, buf, type) · publicUrl(key)
 */

const env = (k) => process.env[k]?.trim();

function s3Driver() {
  const bucket = env("S3_BUCKET");
  const region = env("S3_REGION") ?? "eu-west-1";
  let clientPromise;
  const sdk = () => import("@aws-sdk/client-s3");
  const client = () =>
    (clientPromise ??= sdk().then(
      ({ S3Client }) =>
        new S3Client({
          region,
          credentials: { accessKeyId: env("S3_ACCESS_KEY_ID") ?? "", secretAccessKey: env("S3_SECRET_ACCESS_KEY") ?? "" },
        }),
    ));

  return {
    name: "s3",
    async getJSON(key) {
      const { GetObjectCommand } = await sdk();
      try {
        const out = await (await client()).send(new GetObjectCommand({ Bucket: bucket, Key: key }));
        return JSON.parse(await out.Body.transformToString());
      } catch (e) {
        if (e?.name === "NoSuchKey" || e?.$metadata?.httpStatusCode === 404) return null;
        throw e;
      }
    },
    async putJSON(key, obj) {
      const { PutObjectCommand } = await sdk();
      await (await client()).send(
        new PutObjectCommand({ Bucket: bucket, Key: key, Body: JSON.stringify(obj), ContentType: "application/json", CacheControl: "no-store" }),
      );
    },
    async remove(key) {
      const { DeleteObjectCommand } = await sdk();
      await (await client()).send(new DeleteObjectCommand({ Bucket: bucket, Key: key }));
    },
    async list(prefix, max = 1000) {
      const { ListObjectsV2Command } = await sdk();
      const keys = [];
      let token;
      do {
        const out = await (await client()).send(new ListObjectsV2Command({ Bucket: bucket, Prefix: prefix, ContinuationToken: token, MaxKeys: Math.min(1000, max - keys.length) }));
        (out.Contents ?? []).forEach((o) => keys.push(o.Key));
        token = out.IsTruncated && keys.length < max ? out.NextContinuationToken : undefined;
      } while (token);
      return keys;
    },
    async putBinary(key, buffer, contentType) {
      const { PutObjectCommand } = await sdk();
      await (await client()).send(
        new PutObjectCommand({ Bucket: bucket, Key: key, Body: buffer, ContentType: contentType, CacheControl: "public, max-age=31536000, immutable" }),
      );
    },
    publicUrl(key) {
      const base = env("S3_PUBLIC_BASE_URL");
      return base ? `${base.replace(/\/$/, "")}/${key}` : `https://${bucket}.s3.${region}.amazonaws.com/${key}`;
    },
  };
}

function fsDriver(root = path.resolve(".local-data")) {
  const file = (key) => path.join(root, ...key.split("/"));
  const walk = async (dir) => {
    const out = [];
    for (const e of await fs.readdir(dir, { withFileTypes: true }).catch(() => [])) {
      const p = path.join(dir, e.name);
      if (e.isDirectory()) out.push(...(await walk(p)));
      else out.push(p);
    }
    return out;
  };
  return {
    name: "fs",
    root,
    async getJSON(key) {
      try {
        return JSON.parse(await fs.readFile(file(key), "utf8"));
      } catch (e) {
        if (e.code === "ENOENT") return null;
        throw e;
      }
    },
    async putJSON(key, obj) {
      await fs.mkdir(path.dirname(file(key)), { recursive: true });
      await fs.writeFile(file(key), JSON.stringify(obj, null, 2));
    },
    async remove(key) {
      await fs.rm(file(key), { force: true });
    },
    async list(prefix, max = 1000) {
      const keys = (await walk(root)).map((p) => path.relative(root, p).split(path.sep).join("/")).filter((k) => k.startsWith(prefix));
      return keys.slice(0, max);
    },
    async putBinary(key, buffer) {
      await fs.mkdir(path.dirname(file(key)), { recursive: true });
      await fs.writeFile(file(key), buffer);
    },
    publicUrl: (key) => `/__local/${key}`,
  };
}

export function memoryDriver() {
  const store = new Map();
  return {
    name: "memory",
    store,
    async getJSON(key) {
      return store.has(key) ? JSON.parse(store.get(key)) : null;
    },
    async putJSON(key, obj) {
      store.set(key, JSON.stringify(obj));
    },
    async remove(key) {
      store.delete(key);
    },
    async list(prefix, max = 1000) {
      return [...store.keys()].filter((k) => k.startsWith(prefix)).slice(0, max);
    },
    async putBinary(key, buffer) {
      store.set(key, buffer);
    },
    publicUrl: (key) => `https://test.invalid/${key}`,
  };
}

let current;

/**
 * Is a real storage backend available? When false the platform runs in DEMO MODE: the console and checkout use the
 * browser-local demo backend (src/demo) and the API refuses data calls with 503. Set DEMO_MODE=1 to force it locally.
 */
export function storageConfigured() {
  if (process.env.DEMO_MODE === "1") return false;
  if (current) return true;
  const wanted = env("STORAGE_DRIVER");
  if (wanted === "memory" || wanted === "fs") return true;
  if (env("S3_BUCKET")) return true;
  return !(process.env.VERCEL_ENV === "production" || process.env.NODE_ENV === "production");
}

export function getStorage() {
  if (current) return current;
  const wanted = env("STORAGE_DRIVER");
  const production = process.env.VERCEL_ENV === "production" || process.env.NODE_ENV === "production";
  if (wanted === "memory") current = memoryDriver();
  else if (wanted === "fs") current = fsDriver();
  else if (env("S3_BUCKET")) current = s3Driver();
  else if (!production) current = fsDriver();
  else throw new Error("Storage is not configured: set S3_BUCKET, S3_REGION, S3_ACCESS_KEY_ID and S3_SECRET_ACCESS_KEY.");
  return current;
}

/** Test hook. */
export function setStorageForTests(driver) {
  current = driver;
}
</file>

<file path="api/checkout.js">
import { allow, baseUrl, fail, ok, parseBody } from "./_lib/http.js";
import { requireStorage } from "./_lib/guard.js";
import { loadMenuDoc } from "./_lib/menuStore.js";
import { resolveOrderLines } from "../src/lib/orderLines.js";
import { addAttempt, buildInvoice, saveInvoice, validateCustomer } from "./_lib/invoices.js";
import { initializeTransaction, paystackMode } from "./_lib/paystack.js";
import { computeTotals } from "../src/lib/pricing.js";
import { getOpenStatus } from "../src/lib/hours.js";

/**
 * POST /api/checkout
 *   { items:[{id,quantity}], fulfilment:"pickup"|"delivery", intent:"pay"|"invoice", customer? }
 *
 *   intent "pay"     → needs full customer details → { invoiceId, invoiceUrl, authorizationUrl }   (Paystack)
 *   intent "invoice" → no details needed           → { invoiceId, invoiceUrl, code, expiresAt, total } (WhatsApp)
 *
 * Prices, availability, delivery fee and minimum order are all decided HERE from the live menu.
 */
export default async function handler(req, res) {
  if (!allow(req, res, ["POST"])) return;
  if (!requireStorage(res)) return;
  const body = parseBody(req);

  const doc = await loadMenuDoc();
  const settings = doc.settings;
  if (!settings.acceptingOrders) return fail(res, 403, "We're not taking orders right now. Please check back soon.", { code: "closed" });

  if (settings.autoPauseOutsideHours && !getOpenStatus(settings.hours, new Date(), settings.closures).open) {
    return fail(res, 403, "We're closed right now. Please order during opening hours.", { code: "closed" });
  }

  const fulfilment = body.fulfilment === "delivery" ? "delivery" : "pickup";
  const zoneId = typeof body.zoneId === "string" ? body.zoneId : null;
  if (fulfilment === "delivery" && !settings.deliveryEnabled) return fail(res, 400, "Delivery isn't available right now. Choose pickup instead.", { code: "no_delivery" });

  const resolved = resolveOrderLines(body.items, doc);
  if (!resolved.ok) return fail(res, resolved.code === "sold_out" || resolved.code === "unknown_item" ? 409 : 400, resolved.error, { code: resolved.code, soldOut: resolved.soldOut });

  const intent = body.intent === "pay" ? "pay" : "invoice";
  const totals = computeTotals(resolved.lines.map((l) => ({ unitPrice: l.item.price, quantity: l.quantity })), fulfilment, settings, { zoneId, payOnline: intent === "pay" });
  if (totals.zoneRequired) return fail(res, 422, "Please choose your delivery area.", { fields: { zone: "Choose your delivery area." } });
  if (totals.belowMinimum) return fail(res, 400, `The minimum order is ₦${totals.minOrder.toLocaleString("en-NG")}. Add ₦${totals.shortBy.toLocaleString("en-NG")} more.`, { code: "below_minimum" });

  let customer = {};
  if (intent === "pay") {
    const v = validateCustomer(body.customer, fulfilment);
    if (!v.ok) return fail(res, 422, "Please check your details.", { fields: v.errors });
    customer = v.customer;
    if (paystackMode() === "off") return fail(res, 503, "Online payment isn't switched on yet. You can still order on WhatsApp.", { code: "payments_off" });
  }

  const record = buildInvoice({ lines: resolved.lines, fulfilment, channel: intent === "pay" ? "web" : "whatsapp", settings, zoneId, customer });
  const invoiceUrl = `${baseUrl(req)}/invoice/${record.id}`;

  if (intent === "invoice") {
    await saveInvoice(record);
    return ok(res, { invoiceId: record.id, invoiceUrl, code: record.code, expiresAt: record.expiresAt, total: record.total });
  }

  const { reference, amountKobo } = addAttempt(record, { fulfilment, zoneId, settings, customer });
  try {
    const init = await initializeTransaction({
      email: customer.email,
      amountKobo,
      reference,
      callbackUrl: invoiceUrl,
      metadata: { invoiceId: record.id, code: record.code, customer: customer.name },
    });
    await saveInvoice(record);
    return ok(res, { invoiceId: record.id, invoiceUrl, authorizationUrl: init.authorizationUrl });
  } catch (e) {
    console.error("Paystack initialize failed:", e.message);
    return fail(res, 502, "We couldn't reach the payment provider. Please try again, or order on WhatsApp.");
  }
}
</file>

<file path="api/invoice/[id].js">
import { allow, baseUrl, fail, ok, parseBody } from "../_lib/http.js";
import { requireStorage } from "../_lib/guard.js";
import { loadMenuDoc } from "../_lib/menuStore.js";
import { addAttempt, isExpired, isValidId, loadInvoice, saveInvoice, settle, validateCustomer } from "../_lib/invoices.js";
import { initializeTransaction, paystackMode, verifyTransaction } from "../_lib/paystack.js";
import { computeTotals } from "../../src/lib/pricing.js";
import { getOpenStatus } from "../../src/lib/hours.js";

const idFrom = (req) => req.query?.id ?? new URL(req.url, "http://x").pathname.split("/").filter(Boolean).pop();
const queryOf = (req, key) => req.query?.[key] ?? new URL(req.url, "http://x").searchParams.get(key);

/** What the browser is allowed to see. */
const view = (r) => ({
  id: r.id, code: r.code, status: r.status, channel: r.channel, createdAt: r.createdAt, expiresAt: r.expiresAt,
  items: r.items, subtotal: r.subtotal, deliveryFee: r.deliveryFee, serviceFee: r.serviceFee ?? 0, total: r.total, fulfilment: r.fulfilment,
  zone: r.zone ?? null, prepMins: r.prepMins,
  customer: r.customer, payment: r.payment ? { ...r.payment, reference: r.payment.reference } : undefined,
});

/**
 * /api/invoice/:id
 *   GET   → invoice (pending) or receipt (paid). When a payment has been attempted it is confirmed with Paystack first.
 *           Add ?reference=… (Paystack's redirect does this) to check a specific attempt.
 *   POST  { action:"pay", fulfilment, customer } → starts a Paystack payment for this invoice → { authorizationUrl }
 */
export default async function handler(req, res) {
  if (!allow(req, res, ["GET", "POST"])) return;
  if (!requireStorage(res)) return;
  const id = idFrom(req);
  if (!isValidId(id)) return fail(res, 404, "We couldn't find that invoice.");

  const record = await loadInvoice(id);
  if (!record) return fail(res, 404, "We couldn't find that invoice. It may have expired.", { status: "missing" });
  if (record.status === "paid") return req.method === "GET" ? ok(res, { status: "paid", receipt: view(record), mode: record.payment?.mode }) : fail(res, 409, "This invoice has already been paid.", { status: "paid" });

  if (req.method === "GET") {
    // Confirm any payment attempt with Paystack (covers: customer returned from Paystack, or paid in another tab/bank app).
    const wanted = queryOf(req, "reference");
    const refs = [wanted, ...[...record.attempts].reverse().map((a) => a.reference)].filter(Boolean);
    for (const ref of [...new Set(refs)].slice(0, 3)) {
      const attempt = record.attempts.find((a) => a.reference === ref);
      if (!attempt) continue;
      try {
        const verification = await verifyTransaction(ref, { mockApproved: queryOf(req, "mock") === "success", mockAmountKobo: attempt.amountKobo });
        const receipt = await settle(record, ref, verification, { mode: paystackMode() });
        if (receipt) return ok(res, { status: "paid", receipt: view(receipt), mode: receipt.payment.mode });
      } catch (e) {
        console.error("Verify failed:", e.message);
      }
    }
    if (isExpired(record)) return fail(res, 410, "This invoice has expired.", { status: "expired", code: record.code });
    return ok(res, { status: "pending", invoice: view(record), checking: Boolean(wanted) });
  }

  // POST — pay
  if (isExpired(record)) return fail(res, 410, "This invoice has expired. Please place a new order.", { status: "expired" });
  const body = parseBody(req);
  if (body.action !== "pay") return fail(res, 400, "Unknown action.");

  const doc = await loadMenuDoc();
  if (!doc.settings.acceptingOrders) return fail(res, 403, "We're not taking orders right now.", { code: "closed" });
  if (doc.settings.autoPauseOutsideHours && !getOpenStatus(doc.settings.hours, new Date(), doc.settings.closures).open) return fail(res, 403, "We're closed right now.", { code: "closed" });
  const fulfilment = body.fulfilment === "delivery" ? "delivery" : "pickup";
  const zoneId = typeof body.zoneId === "string" ? body.zoneId : null;
  if (fulfilment === "delivery" && !doc.settings.deliveryEnabled) return fail(res, 400, "Delivery isn't available right now. Choose pickup instead.");
  const preview = computeTotals(record.items, fulfilment, doc.settings, { zoneId, payOnline: true });
  if (preview.zoneRequired) return fail(res, 422, "Please choose your delivery area.", { fields: { zone: "Choose your delivery area." } });
  if (preview.belowMinimum) return fail(res, 400, `The minimum order is ₦${preview.minOrder.toLocaleString("en-NG")}.`, { code: "below_minimum" });
  if (paystackMode() === "off") return fail(res, 503, "Online payment isn't switched on yet. Please pay via WhatsApp.", { code: "payments_off" });

  const v = validateCustomer(body.customer, fulfilment);
  if (!v.ok) return fail(res, 422, "Please check your details.", { fields: v.errors });

  const { reference, amountKobo } = addAttempt(record, { fulfilment, zoneId, settings: doc.settings, customer: v.customer });
  try {
    const init = await initializeTransaction({
      email: v.customer.email, amountKobo, reference, callbackUrl: `${baseUrl(req)}/invoice/${record.id}`,
      metadata: { invoiceId: record.id, code: record.code, customer: v.customer.name },
    });
    await saveInvoice(record);
    return ok(res, { authorizationUrl: init.authorizationUrl });
  } catch (e) {
    console.error("Paystack initialize failed:", e.message);
    return fail(res, 502, "We couldn't reach the payment provider. Please try again.");
  }
}
</file>

