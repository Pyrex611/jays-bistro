<file path="api/_lib/http.js">
/** Tiny helpers shared by all API handlers. Works on Vercel Node functions and the local dev middleware. */

export function send(res, status, body, headers = {}) {
  res.statusCode = status;
  res.setHeader("Content-Type", "application/json; charset=utf-8");
  for (const [k, v] of Object.entries(headers)) res.setHeader(k, v);
  res.end(JSON.stringify(body));
}

export const ok = (res, body, headers) => send(res, 200, body, { "Cache-Control": "no-store", ...headers });
export const fail = (res, status, error, extra = {}) => send(res, status, { error, ...extra }, { "Cache-Control": "no-store" });

export function parseBody(req) {
  const b = req.body;
  if (b && typeof b === "object" && !Buffer.isBuffer(b)) return b;
  if (typeof b === "string") {
    try {
      return JSON.parse(b);
    } catch {
      return {};
    }
  }
  return {};
}

/** Returns true if the method is allowed; otherwise answers 405 and returns false. */
export function allow(req, res, methods) {
  if (methods.includes(req.method)) return true;
  res.setHeader("Allow", methods.join(", "));
  fail(res, 405, "Method not allowed");
  return false;
}

/** CSRF defence in depth: state-changing portal calls must carry this custom header (browsers block cross-site use of it). */
export function requireAjax(req, res) {
  if (req.headers["x-requested-with"] === "jb-portal") return true;
  fail(res, 403, "Missing request header");
  return false;
}

export function parseCookies(req) {
  const out = {};
  for (const part of String(req.headers.cookie ?? "").split(";")) {
    const i = part.indexOf("=");
    if (i > 0) out[part.slice(0, i).trim()] = decodeURIComponent(part.slice(i + 1).trim());
  }
  return out;
}

export const isHttps = (req) => (req.headers["x-forwarded-proto"] ?? "").split(",")[0] === "https";

export function clientIp(req) {
  const fwd = String(req.headers["x-forwarded-for"] ?? "").split(",")[0].trim();
  return fwd || req.socket?.remoteAddress || "unknown";
}

/** Public origin used for links we generate (invoice URLs, Paystack callback). Prefer PUBLIC_BASE_URL. */
export function baseUrl(req) {
  if (process.env.PUBLIC_BASE_URL) return process.env.PUBLIC_BASE_URL.replace(/\/$/, "");
  const proto = (req.headers["x-forwarded-proto"] ?? "http").split(",")[0];
  const host = req.headers["x-forwarded-host"] ?? req.headers.host ?? "localhost:5173";
  return `${proto}://${host}`;
}

export const isProduction = () => process.env.VERCEL_ENV === "production" || process.env.NODE_ENV === "production";
</file>

<file path="api/_lib/menuStore.js">
import { getStorage } from "./storage.js";
import { defaultMenuDoc, validateMenuDoc } from "../../src/lib/menuDoc.js";

const KEY = "data/menu.json";

/** Loads the live menu. Public reads never fail: they fall back to the bundled default catalogue. */
export async function loadMenuDoc({ strict = false } = {}) {
  try {
    const stored = await getStorage().getJSON(KEY);
    if (stored) {
      const v = validateMenuDoc(stored);
      if (v.ok) return { ...v.doc, version: stored.version ?? 0, updatedAt: stored.updatedAt ?? null, source: "storage" };
    }
  } catch (e) {
    if (strict) throw e;
  }
  return { ...defaultMenuDoc(), source: "default" };
}

export class MenuConflict extends Error {
  constructor(current) {
    super("The menu changed since you opened it.");
    this.current = current;
  }
}
export class MenuInvalid extends Error {
  constructor(errors) {
    super("Menu validation failed");
    this.errors = errors;
  }
}

/** Optimistic concurrency: the caller must pass the version it loaded. */
export async function saveMenuDoc(input, baseVersion) {
  const current = await loadMenuDoc({ strict: true });
  if (baseVersion !== current.version) throw new MenuConflict(current);
  const v = validateMenuDoc(input);
  if (!v.ok) throw new MenuInvalid(v.errors);
  const doc = { ...v.doc, version: current.version + 1, updatedAt: new Date().toISOString() };
  await getStorage().putJSON(KEY, doc);
  return { ...doc, source: "storage" };
}
</file>

<file path="api/_lib/orderLines.js">
/** Validate the cart the browser sent against the live menu. Prices always come from the menu, never from the client. */
export function resolveOrderLines(rawItems, doc) {
  if (!Array.isArray(rawItems) || rawItems.length === 0) return { ok: false, error: "Your tray is empty." };
  if (rawItems.length > 40) return { ok: false, error: "Too many different items in one order." };

  const byId = new Map(doc.items.filter((i) => i.isActive !== false).map((i) => [i.id, i]));
  const merged = new Map();
  for (const raw of rawItems) {
    const id = Number(raw?.id);
    const quantity = Math.trunc(Number(raw?.quantity));
    if (!Number.isInteger(id) || !byId.has(id)) return { ok: false, error: "An item in your tray is no longer on the menu.", code: "unknown_item" };
    if (!Number.isInteger(quantity) || quantity < 1 || quantity > 20) return { ok: false, error: "Quantities must be between 1 and 20." };
    merged.set(id, Math.min(20, (merged.get(id) ?? 0) + quantity));
  }

  const lines = [...merged].map(([id, quantity]) => ({ item: byId.get(id), quantity }));
  const soldOut = lines.filter((l) => l.item.isAvailable === false).map((l) => l.item.name);
  if (soldOut.length) return { ok: false, error: `Sold out today: ${soldOut.join(", ")}. Please remove ${soldOut.length > 1 ? "them" : "it"} to continue.`, code: "sold_out", soldOut };

  return { ok: true, lines };
}
</file>

<file path="dev/apiPlugin.js">
import fs from "node:fs";
import path from "node:path";
import { loadEnv } from "vite";

/**
 * Dev-only: serves the /api/* functions from `npm run dev` (no `vercel dev` or login needed).
 * Reads .env.local into process.env, maps URLs to files in /api (supports [param] files), and serves
 * locally stored images from .local-data under /__local/. Not used in production builds.
 */
const TYPES = { ".webp": "image/webp", ".png": "image/png", ".jpg": "image/jpeg", ".jpeg": "image/jpeg" };

function resolveRoute(pathname) {
  const segments = pathname.replace(/^\/api\/?/, "").split("/").filter(Boolean);
  let dir = path.resolve("api");
  const params = {};
  for (let i = 0; i < segments.length; i += 1) {
    const seg = segments[i];
    if (seg.startsWith("_")) return null;
    const last = i === segments.length - 1;
    const exactFile = path.join(dir, `${seg}.js`);
    const exactDir = path.join(dir, seg);
    if (last && fs.existsSync(exactFile)) return { file: exactFile, params };
    if (!last && fs.existsSync(exactDir) && fs.statSync(exactDir).isDirectory()) { dir = exactDir; continue; }
    const dynamicFile = fs.existsSync(dir) && fs.readdirSync(dir).find((f) => /^\[.+\]\.js$/.test(f));
    if (last && dynamicFile) return { file: path.join(dir, dynamicFile), params: { ...params, [dynamicFile.slice(1, -4)]: seg } };
    return null;
  }
  const index = path.join(dir, "index.js");
  return fs.existsSync(index) ? { file: index, params } : null;
}

export function apiDevPlugin() {
  return {
    name: "jb-api-dev",
    apply: "serve",
    configureServer(server) {
      for (const [k, v] of Object.entries(loadEnv("development", process.cwd(), ""))) {
        if (process.env[k] === undefined) process.env[k] = v;
      }

      server.middlewares.use(async (req, res, next) => {
        const url = new URL(req.url, "http://localhost");

        if (url.pathname.startsWith("/__local/")) {
          const file = path.resolve(".local-data", url.pathname.replace("/__local/", ""));
          if (!file.startsWith(path.resolve(".local-data")) || !fs.existsSync(file)) return next();
          res.setHeader("Content-Type", TYPES[path.extname(file)] ?? "application/octet-stream");
          return fs.createReadStream(file).pipe(res);
        }
        if (!url.pathname.startsWith("/api/")) return next();

        const route = resolveRoute(url.pathname);
        if (!route) {
          res.statusCode = 404;
          res.setHeader("Content-Type", "application/json");
          return res.end(JSON.stringify({ error: "Not found" }));
        }

        const chunks = [];
        for await (const c of req) chunks.push(c);
        const raw = Buffer.concat(chunks).toString();
        if (raw && String(req.headers["content-type"] ?? "").includes("json")) {
          try { req.body = JSON.parse(raw); } catch { req.body = {}; }
        } else if (raw) req.body = raw;
        req.query = { ...Object.fromEntries(url.searchParams), ...route.params };

        try {
          const mod = await server.ssrLoadModule(route.file);
          await mod.default(req, res);
        } catch (e) {
          console.error(`[api] ${req.method} ${url.pathname} failed:`, e);
          if (!res.headersSent) {
            res.statusCode = 500;
            res.setHeader("Content-Type", "application/json");
          }
          res.end(JSON.stringify({ error: "Server error" }));
        }
      });
    },
  };
}
</file>

<file path="docs/adr/0005-s3-storage-and-password-lock.md">
# ADR-0005: S3 for storage; password-locked merchant portal with no auth provider

- **Status:** Accepted
- **Date:** 2026-10-26

## Context
The owner wants a merchant portal on its own page, protected by a password, without an auth provider, and suggested keeping the password in an S3 bucket and comparing against it. The site is a Vite SPA on Vercel; we need server-side code for Paystack anyway.

## Decision
- **Vercel Functions** (`/api`) are the only code that touches storage and secrets.
- **One S3 bucket** holds everything. Only `images/*` is public-read; all else is private (layout in `docs/MERCHANT_PORTAL.md`).
- **Password check on the server**, against a **scrypt hash** in `config/merchant.json` (never plain text, never readable by the browser). Starter password from env; forced change on first login.
- **Session**: HMAC-signed, HttpOnly, SameSite=Strict cookie, 12 h, bound to the password-hash fingerprint (changing the password revokes all sessions).
- **Throttle**: 5 failures / IP / 15 min.
- **Storage interface** with S3, local-file and in-memory drivers, so dev needs no AWS and tests are fast.
- **Menu = one versioned JSON document** (`data/menu.json`) with optimistic concurrency; the bundled catalogue is the fallback.

## Why not the browser-side check
Anything the browser can read, anyone can read; anything the browser decides, anyone can bypass. The check must live where the secret lives.

## Consequences
- ✅ No third-party auth, no monthly cost beyond S3 pennies; simple mental model.
- ✅ Free local dev (`.local-data/`), 100 automated tests including the lock, CSRF header, throttling and password change.
- ⚠️ Single shared password, no 2FA, no per-person audit trail.
- ⚠️ JSON-in-S3 has no queries: orders listing reads receipt files by month (fine for hundreds per month; revisit around a few thousand).
- ⚠️ Last-write-wins on S3 beyond the version check (acceptable for one merchant).
- Upgrade path: swap `requireMerchant` for a real provider and move receipts to a database; the API shapes stay.
</file>

<file path="docs/adr/0006-paystack-invoices-receipts.md">
# ADR-0006: Paystack hosted checkout, expiring invoices, receipts

- **Status:** Accepted
- **Date:** 2026-10-26

## Decision
- **Paystack redirect flow** (server `initialize` → hosted page → callback to `/invoice/<id>`). No Paystack public key or card UI in our bundle; the secret key lives in `PAYSTACK_SECRET_KEY` (server env only).
- **Invoice lifecycle:** `invoices/pending/<id>.json` (24 h validity; S3 lifecycle deletes at 3 days) → on verified payment `receipts/<yyyy>/<mm>/<id>.json`. One URL serves invoice, receipt and expired states.
- **Trust model:** only Paystack's `verify` API settles a payment, and only for the exact kobo amount of that attempt in NGN. Webhook and redirect are triggers, never evidence.
- **WhatsApp checkout** creates the same invoice and shares its link, so WhatsApp orders can also be paid online and become receipts.
- **Mock mode** (no key, not production) enables full end-to-end testing without Paystack; receipts are stamped TEST.

## Alternatives
Paystack Inline popup (needs public key + more client code, weaker on some mobile browsers) · Payment links without invoices (no itemised receipt, no analytics) · Webhook-only settlement (fails if the webhook is delayed while the customer is staring at the page).

## Consequences
✅ Real receipts and sales analytics. ✅ No payment data touches our servers. ⚠️ Verification needs Paystack reachable; the page keeps polling and the webhook is the backstop. ⚠️ Raw-body signature checking isn't available on Vercel's parsed body, which is why verification goes through the API.
</file>

<file path="docs/adr/0007-vercel-blob-and-demo-mode.md">
# ADR-0007: Vercel Blob as the target store; ship a capability-driven demo first

- **Status:** Proposed. Becomes Accepted when the owner approves going live (storage not connected yet by design)
- **Date:** 2026-11-01
- **Supersedes (when accepted):** the S3 default in [ADR-0005](0005-s3-storage-and-password-lock.md). The password lock, cookie, throttle and storage *interface* are unchanged.

## Context
The owner wants everything on one platform (Vercel) and wants to see and approve **all** pages and features before any account
is connected. Storage did not exist yet, so nothing could be shown on the live site.

## Decision
1. **Demo mode first** ([DEMO_MODE.md](../DEMO_MODE.md)): every integration has a real and a demo implementation chosen by `capabilities`.
2. **Vercel Blob replaces S3 as the default store at go-live**, behind the existing `getStorage()` interface (`getJSON/putJSON/remove/list/putBinary/publicUrl`). The S3 driver stays (≈100 lines, tested) as an alternative.
3. **Two Blob stores**: a **public** one for dish photos (and nothing else), a **private** one for the menu document, settings, invoices, receipts, alert log and the password hash. Vercel allows unlimited stores on every plan.
4. Retention: receipts keep totals forever; purge customer phone/address after 12 months (default; owner to confirm).

## Research findings (Vercel docs as read on 2026-09-23 and 2026-11-01: verify again at go-live)
| Topic | Finding | Consequence |
|---|---|---|
| Hobby quota | 1 GB stored; first 10,000 simple ops/month; first 2,000 advanced ops (uploads, list, copy)/month; 10 GB transfer | Plenty: a menu of 64 dishes, ~hundreds of JSON receipts/month |
| Rate limits | Hobby: 20 simple ops/s, 15 advanced ops/s | Fine for one kitchen |
| Over the limit | Blob access is **blocked** until 30 days pass (no overage bill; warning emails) | Stay under 2,000 uploads/month: each order writes ~2 objects (pending → receipt) |
| Caching | Cache hits don't count as simple operations | Serve the menu through the edge-cached `/api/menu` and public photo URLs |
| Writes | Overwrite is opt-in; conditional writes (`ifMatch`) exist | Use them for the versioned menu document |
| Lifecycle | **No TTL** | A daily Vercel Cron job deletes expired pending invoices and attempt files (Hobby cron: once/day, production only) |
| Commercial use | **Hobby is restricted to non-commercial personal use** | **A restaurant taking real payments needs Pro** before go-live |

## Alternatives considered
- Keep S3: works today, but a second vendor, keys to manage, and the AWS console steps in `docs/AWS_SETUP.md`.
- One private store + an image proxy function: fewer stores, but every photo costs a function invocation and cold starts; two stores is simpler.
- Supabase/Postgres: rejected earlier (ADR-0002); JSON documents are enough at this scale.

## Consequences
✅ Customers and owner can try everything now; nothing is built twice. ✅ Go-live is configuration plus a short, listed amount of server work. ⚠️ Demo state is browser-local, so a multi-device demo is not possible until storage exists. ⚠️ Pro plan cost before taking real orders.
</file>

<file path="docs/AWS_SETUP.md">
# AWS S3 setup (once, ~15 minutes)

You need: an AWS account. Cost at this scale: well under $1/month.

## 1. Create the bucket
1. AWS Console → **S3** → **Create bucket**.
2. Name: `jays-bistro-data` (must be globally unique: add a suffix if taken, e.g. `jays-bistro-data-ng`). Region: **EU (Ireland) eu-west-1** (Cape Town `af-south-1` is closer but must be enabled in your account first).
3. **Block Public Access:** *untick* only the two "…public **bucket policies**…" boxes (the ones about `new public bucket or access point policies` and `any public bucket or access point policies`); **keep the two ACL boxes ticked**. Confirm the warning. (This lets the policy below expose `images/` and nothing else.)
4. Leave encryption at the default (SSE-S3). **Create bucket**.

## 2. Bucket policy — only dish photos are public
Bucket → **Permissions** → **Bucket policy** → paste (replace both `jays-bistro-data` with your bucket name):
```json
{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublicReadDishPhotosOnly",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::jays-bistro-data/images/*"
    }
  ]
}
```

## 3. Lifecycle rules — keep the bucket tidy automatically
Bucket → **Management** → **Create lifecycle rule** (twice):
| Rule name | Prefix | Action |
|---|---|---|
| `expire-unpaid-invoices` | `invoices/pending/` | Expire current versions **3 days** after creation |
| `expire-login-attempts` | `config/attempts/` | Expire current versions **1 day** after creation |

(Invoices are valid for 24 h; the extra 2 days cover a payment started just before expiry.)

## 4. A least-privilege user for the app
1. **IAM** → **Users** → **Create user** `jays-bistro-app` (no console access).
2. **Permissions** → **Create inline policy** → JSON (replace the bucket name):
```json
{
  "Version": "2012-10-17",
  "Statement": [
    { "Effect": "Allow", "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"], "Resource": "arn:aws:s3:::jays-bistro-data/*" },
    { "Effect": "Allow", "Action": "s3:ListBucket", "Resource": "arn:aws:s3:::jays-bistro-data" }
  ]
}
```
3. User → **Security credentials** → **Create access key** → *Application running outside AWS* → copy the **Access key ID** and **Secret access key** (shown once).

## 5. Put the values in Vercel
Vercel → project → **Settings → Environment Variables** (Production **and** Preview):

| Name | Value |
|---|---|
| `S3_BUCKET` | `jays-bistro-data` |
| `S3_REGION` | `eu-west-1` |
| `S3_ACCESS_KEY_ID` | from step 4 |
| `S3_SECRET_ACCESS_KEY` | from step 4 |
| `SESSION_SECRET` | 32+ random characters |
| `MERCHANT_BOOTSTRAP_PASSWORD` | a starter password (you change it on first login) |
| `PAYSTACK_SECRET_KEY` | `sk_test_…` first, `sk_live_…` when you go live |
| `PUBLIC_BASE_URL` | `https://jays-bistro.vercel.app` |

> Why `S3_*` and not `AWS_*`? Vercel reserves the `AWS_*` names for its own runtime.

Redeploy after adding variables.

## 6. Verify the bucket is locked down
In a browser (replace names):
- `https://jays-bistro-data.s3.eu-west-1.amazonaws.com/config/merchant.json` → must show **AccessDenied**.
- `https://jays-bistro-data.s3.eu-west-1.amazonaws.com/data/menu.json` → must show **AccessDenied**.
- After uploading a photo from the console, its `images/…` URL must open.

## 7. Paystack
1. Dashboard → **Settings → API Keys & Webhooks**.
2. Copy the **Test Secret Key** into `PAYSTACK_SECRET_KEY`.
3. **Test Webhook URL:** `https://jays-bistro.vercel.app/api/paystack/webhook` → Save.
4. Try an order with a Paystack test card (see Paystack's test-cards page).
5. Going live: complete Paystack's business verification, then put the **Live Secret Key** in Vercel, set the **Live Webhook URL** to the same address, redeploy.
</file>

<file path="docs/CONCEPTS.md">
# Concept deep-dive: dashboard, hero management, sales analytics

Brainstorm and design thinking behind Phases 2–3. Decisions that stick graduate into INTENT / ADRs.

---

## A. Menu management dashboard

### Who and how
The owner will mostly use a **phone**, between customers. So the dashboard is mobile-first too: big tap targets, one-handed flows, no tables that need horizontal scroll. Desktop gets a two-pane layout (list + editor).

### Jobs to be done (ranked by frequency)
1. "We're out of Isi-ewu **right now**" → one-tap **Sold out today** (no editing, auto-clears at 04:00 Lagos time).
2. "Change the price of Jollof" → inline price edit from the list.
3. "Add a new dish" → photo → name → price → category → done (≤ 60 s).
4. "Feature something on the home screen" → hero manager (section B).
5. "Retire a dish for good" → **Archive** (reversible).

### Item lifecycle
`active/available` → `active/sold-out` → `hidden (inactive)` → `archived`. Three different intents, three different controls:
- **Sold out** (`is_available=false`): visible but greyed with a badge, cannot be added. Staff allowed.
- **Hidden** (`is_active=false`): not on the menu, kept for later (seasonal dishes).
- **Archived** (`archived_at`): removed from lists; history intact. Hard-delete only if never ordered.

### Safeguards (what protects the owner from mistakes)
- Price edits show old → new and require a confirm when the change is > 50 % or the price is 0/missing.
- Undo toast for 8 s after hide/archive/price change; full audit log (who/what/when, before/after).
- Image upload validates type/size, previews on the real card, and warns when a "cutout" has no transparency.
- Names ≤ 80 chars, descriptions ≤ 280 (cards clamp to 2 lines — validation matches the layout).

### Roles
| Capability | Staff | Owner |
|---|:-:|:-:|
| Toggle sold-out | ✅ | ✅ |
| View orders, set status | ✅ | ✅ |
| Edit items, prices, categories | ❌ | ✅ |
| Hero / promo management | ❌ | ✅ |
| Analytics, audit log, users | ❌ | ✅ |

### Edge cases worth designing now
Two people editing the same item (last-write-wins + `updated_at` check, "changed by X, reload?") · item in hero gets archived (slot auto-skips, dashboard warns) · category emptied (pill disappears — already handled by `buildMenuModel`) · image upload fails on 3G (retry, keep form state) · price changed while a customer has it in the tray (tray resolves at read time; the WhatsApp message always shows the price they saw confirmed on screen).

### Nice-to-have later
Bulk price change by % per category · duplicate item · daily specials (auto-appear/expire) · import from CSV/Sheets · AI helper: write a mouth-watering description from the name + photo.

---

## B. Hero and sub-hero management

### Model
Slots are an ordered list of **slot entries**, each either:
- **Item slide** — points at a menu item; image, name, description and price follow the item automatically (no duplication to maintain).
- **Promo slide** — owner-authored: title, subtitle, image, optional CTA (open an item, jump to a category, or a link). This is where "Order a set with 40 % discount" lives (INTENT Q3).

Rules: hero 1–6 slides (more kills attention and payload); sub-hero exactly 2; entries may have `starts_at/ends_at` (Friday-night special, Ramadan menu, December promo) and an active switch.

### Editor UX
- Left: reorderable list (drag on desktop, up/down arrows on mobile — no drag-only controls).
- Right/top: **live preview** rendering the real `HeroCarousel`/`SubHero` components, so what the owner sees is what customers get, including cutout vs photo.
- Guard rails: warns when an item in a slot is hidden/sold-out; blocks saving an empty hero; shows "currently live / scheduled / expired" chips.

### Measuring it
Each slide click fires `promo_click` / `product_view` with `source=hero|subhero|grid`. Analytics then answers "do hero slides actually sell?" and ranks slides by click-through → add-to-cart → confirmed order. That closes the loop: the owner learns which dish earns the premium spot.

### Risks
Carousel autoplay can annoy (we pause after interaction, respect reduced motion) · big promo images slow the home page (compress on upload, `loading="eager"` only for slide 1) · stale schedule when the owner forgets (dashboard shows "expires in 2 days").

---

## C. Sales analytics

### The core problem: there is no sale to measure
Checkout ends in a WhatsApp chat. Without capturing orders, analytics can only describe *intent* (taps), not *sales*. Three options:

| Option | What it measures | Effort | Verdict |
|---|---|---|---|
| A. Events only | Funnel up to "Checkout on WhatsApp" tap | Low | Misleading as "sales" |
| **B. Capture + confirm** | Real orders: customer taps checkout → order stored → WhatsApp opens with an order code → owner confirms in dashboard | Medium | **Recommended** |
| C. Online payment (Paystack) | Verified paid orders, automatic | High | Later, on top of B |

**B in practice:** `create_order` RPC stores the order with **server-computed prices** (clients cannot tamper), returns code `JB-4821`; the WhatsApp message gains a line `Order #JB-4821`. The owner (or staff) taps **Confirm** in the inbox when the customer commits; **Delivered** / **Cancelled** later. Revenue counts only confirmed + delivered; unconfirmed "sent" orders appear as **intent**, never mixed in. If the network fails at checkout, WhatsApp still opens (ordering never depends on our backend).

### Metrics that drive decisions
| Question the owner asks | Metric |
|---|---|
| How much did we make this week vs last? | Revenue, orders, AOV with previous-period delta |
| What should I push / drop? | Top items by units and revenue; dead items (0 sales in 30 days) |
| When are we busiest? | Hour × weekday heatmap → staffing, prep, promo timing |
| Is the site working? | Funnel conversion and the biggest drop-off step |
| Does the chatbot earn its keep? | Concierge-assisted share of orders and their AOV |
| Which category carries us? | Category mix |
| Do promos work? | Slide click-through → confirmed-order rate |

### Dashboard shape (mobile-first)
Top: date range chips (Today · 7d · 30d · custom) → 4 KPI cards (Revenue, Orders, AOV, Conversion) with deltas → revenue sparkline → top items list → peak-hours heatmap → funnel → insight cards ("Shawarma is 31 % of units but only 18 % of revenue", "Nothing sold on Tuesdays before 12:00"). CSV export for the accountant.

### Data quality and honesty
- Show **"unconfirmed: N orders"** prominently so undercounting is visible, not hidden.
- Anonymous session id (random, `sessionStorage`), no fingerprinting, no third-party scripts, no PII in events. Phone/name only if the customer types it, with a clear sentence about use (NDPA 2023).
- Bots/previews inflate funnel tops → ignore events from known bot user agents and sessions with 0 interactions.
- Small numbers: hide percentages under n < 10 or label them "low sample".

### Later
Customer repeat rate (opt-in phone hash) · stock forecasting from peak times · automatic Paystack verification · weekly WhatsApp summary to the owner ("Last week: ₦412,000 from 96 orders; top: Jollof").
</file>

<file path="docs/DEMO_MODE.md">
# Demo mode: everything visible now, real integrations later

> **Purpose:** let the owner (and anyone approving the build) open **every page and feature** and try it end to end before any
> account is connected. Integrations are mocked behind the same interfaces as the real ones, so connecting them later
> is configuration plus a small, listed amount of server work, not a rebuild.

## How the app decides: capabilities
`GET /api/menu` returns the menu **plus** `capabilities`:

```json
{ "storage": false, "payments": "demo", "email": false, "orderStatus": false }
```

| Capability | Meaning | Demo value → live value |
|---|---|---|
| `storage` | A real store (S3 today, Vercel Blob later) is connected | `false` → `true` |
| `payments` | Checkout mode | `"demo"` → `"test"` (sk_test_…) → `"live"` (sk_live_…) |
| `email` | Kitchen alerts really send | `false` → `true` (when the email channel ships) |
| `orderStatus` | Order workflow is stored server-side | `false` → `true` |

`src/services/runtime.js` holds these. `src/services/api.js` sends each call to the real endpoint **or** to `src/demo/demoApi.js`
depending on them. **Nothing in components checks "am I in demo mode?" except to show honest labels**; flipping a capability
switches the behaviour of that integration by itself.

**When is it demo?** `storageConfigured()` in `api/_lib/storage.js` is `false` when there are no storage variables **in production**
(or when `DEMO_MODE=1` is set). Locally, without `DEMO_MODE=1`, `npm run dev` uses the file driver and behaves as *live*.
If `/api/menu` doesn't exist at all (404, e.g. static hosting) the client also falls back to demo. A server error (5xx) never
flips to demo: a real outage must look like an outage.

## What you can do in demo mode
| Area | What works | How it's mocked |
|---|---|---|
| Storefront | Everything: browse, search, scroll-aware pills, add/stepper, tray, checkout, WhatsApp invoice | Real UI; data from the bundled menu or the owner's browser-local edits |
| Pay online | Full journey ending in a receipt stamped **DEMO** | `/pay/demo/:id` stands in for Paystack (card / transfer / USSD, success or failure) |
| Invoices | 24-hour expiry, pay later, re-pricing pickup↔delivery, receipts | Stored in the browser, same state machine and shared pricing code |
| Console | All five tabs: Overview, Menu, Home, Orders, Settings | `demoApi.merchant.*` mirrors the real API incl. validation and 409 conflicts |
| Orders | 30 days of seeded orders; **New → Preparing → Ready → Completed** | Deterministic seed; five newest orders are always still in the kitchen pipeline |
| Analytics | KPIs, daily sales, busiest hours, pickup/delivery split, payment methods, top sellers | Same `summarize()` / `breakdowns()` as production |
| Settings | Ordering, delivery areas, service fee calculator, hours + closures, business details, announcement, password change | Edits go to the draft; **Publish** makes them live (to this browser) |
| Alerts | Recipients, events, test alert, alert log, exact email preview | Rendered by the real template (`lib/alertTemplate.js`); logged as **simulated**, nothing is sent |
| Go-live | Status of each integration, what's needed, step-by-step checklist | `lib/integrations.js` from `capabilities` |

**Setup password:** `jays-setup`. Change it in Settings → Security; the new password is kept in this browser only.
**Reset:** Settings → Go live → *Reset demo data* clears every `jb:demo:*` key.

## Limits you must know about
- **Browser-local.** A customer's order on one phone does **not** appear in the console on another device, and a WhatsApp
  invoice link opened on a different device shows "not found". To demo the full loop, use one browser (storefront in one tab,
  `/merchant` in another).
- Nothing is sent to anyone: no email, no WhatsApp, no real payments.
- Unsplash stock photos are hot-linked for now (accepted). Nine dishes show an honest icon tile until a real photo exists.

## What is shared with production (so demo can't drift)
`lib/pricing.js` (totals, zones, service fee), `lib/menuDoc.js` (validation), `lib/settings.js` (normalisation), `lib/hours.js`,
`lib/orderStatus.js`, `lib/orderStats.js`, `lib/alertTemplate.js`, `lib/invoiceModel.js`. The demo API tests
(`demo.test.js`) assert the same business rules as the server tests.

## Consolidation checklist (when you approve)
**Configuration only** (each flips by itself once the server reports it):
1. Connect storage (see ADR-0007); `capabilities.storage` becomes `true`; the demo menu/orders stop being used.
2. Add `PAYSTACK_SECRET_KEY` (`sk_test_…` first): `payments` becomes `"test"`; receipts say TEST, excluded from sales KPIs unless included.
3. Replace with `sk_live_…` and the live webhook when the business account is approved.

**Small server work still to write** (the UI and contracts already exist):
| Item | Where | Notes |
|---|---|---|
| Order status endpoint | `api/merchant/orders/[id]/status` | Persist `fulfilmentStatus` on the receipt; `capabilities.orderStatus = true` |
| Notifications endpoint | `api/merchant/notifications` | Private config + log; until then, in live mode the client reports “not connected yet” (501) and the UI explains it |
| Email channel | `api/_lib/notify/` | Provider (Brevo / Gmail SMTP); call from `settle()`; idempotent per invoice |
| Blob storage driver | `api/_lib/storage.js` | Same interface as S3/fs/memory; two stores (public photos, private data) |
| Retention job | Vercel Cron, daily | Purge expired pending invoices and old attempt files (Blob has no TTL) |

**Remove or keep:** `src/demo/` and `MockPaymentPage` can stay (they are the staging and training mode) or be deleted; nothing else imports them except `services/api.js`, `MenuProvider` and the router.
</file>

