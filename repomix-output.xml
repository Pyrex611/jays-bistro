<file path="src/hooks/useInvoice.js">
import { useCallback, useEffect, useRef, useState } from "react";
import { api } from "../services/api.js";
import { clearStoredCart } from "../lib/cartStorage.js";

const POLL_MS = 3000;
const POLL_MAX = 10;

/**
 * Loads /invoice/:id. Phases: loading | pending | paid | expired | missing | error.
 * If the customer just came back from Paystack (?reference=…) and payment isn't confirmed yet
 * (bank transfers can lag), it re-checks every 3 s for ~30 s before telling them to refresh.
 */
export function useInvoice(id) {
  const [state, setState] = useState({ phase: "loading" });
  const [version, setVersion] = useState(0);
  const polls = useRef(0);

  const reload = useCallback(() => {
    polls.current = 0;
    setVersion((v) => v + 1);
  }, []);

  useEffect(() => {
    let cancelled = false;
    let timer;
    const params = new URLSearchParams(window.location.search);
    const reference = params.get("reference") || params.get("trxref");
    const mock = params.get("mock");

    const load = async () => {
      try {
        const res = await api.invoice(id, reference, mock);
        if (cancelled) return;
        if (res.status === "paid") {
          clearStoredCart();
          setState({ phase: "paid", receipt: res.receipt, mode: res.mode });
          return;
        }
        const waiting = Boolean(reference) && polls.current < POLL_MAX;
        setState({ phase: "pending", invoice: res.invoice, confirming: waiting, gaveUp: Boolean(reference) && !waiting });
        if (waiting) {
          polls.current += 1;
          timer = setTimeout(load, POLL_MS);
        }
      } catch (e) {
        if (cancelled) return;
        if (e.status === 410) setState({ phase: "expired", code: e.data?.code });
        else if (e.status === 404) setState({ phase: "missing" });
        else setState({ phase: "error", message: e.message });
      }
    };
    load();
    return () => {
      cancelled = true;
      clearTimeout(timer);
    };
  }, [id, version]);

  return { ...state, reload };
}
</file>

<file path="src/hooks/useScrollSpy.js">
import { useCallback, useEffect, useRef, useState } from "react";
import { pickActiveGroup } from "../lib/scrollSpy.js";

const prefersReducedMotion = () => typeof window !== "undefined" && window.matchMedia?.("(prefers-reduced-motion: reduce)").matches;
const startOf = (name) => document.querySelector(`[data-group-start="${CSS.escape(name)}"]`);

/**
 * Tracks which menu group is "current" while scrolling and lets the category bar jump to a group.
 * `getLine()` returns the viewport Y (px) that a group's first card must rise above to become current.
 * Updates are rAF-throttled; after a tap-to-jump, spying pauses briefly so the pill doesn't flicker through groups on the way.
 */
export function useScrollSpy(names, { enabled = true, getLine }) {
  const [active, setActive] = useState(names[0] ?? null);
  const lockUntil = useRef(0);
  const key = names.join("|");

  useEffect(() => {
    if (!enabled || names.length === 0) return undefined;
    let frame = 0;

    const compute = () => {
      frame = 0;
      if (performance.now() < lockUntil.current) return;
      const groups = names.map((name) => ({ name, el: startOf(name) })).filter((g) => g.el).map((g) => ({ name: g.name, top: g.el.getBoundingClientRect().top }));
      const atBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4;
      const next = pickActiveGroup(groups, getLine(), atBottom);
      if (next) setActive(next);
    };
    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(compute);
    };

    window.addEventListener("scroll", schedule, { passive: true });
    window.addEventListener("resize", schedule);
    schedule();
    return () => {
      window.removeEventListener("scroll", schedule);
      window.removeEventListener("resize", schedule);
      if (frame) cancelAnimationFrame(frame);
    };
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [enabled, key, getLine]);

  const jumpTo = useCallback((name) => {
    const el = startOf(name);
    if (!el) return;
    setActive(name);
    lockUntil.current = performance.now() + 800;
    el.scrollIntoView({ behavior: prefersReducedMotion() ? "auto" : "smooth", block: "start" });
  }, []);

  return { active: active ?? names[0] ?? null, jumpTo };
}
</file>

<file path="src/lib/alertTemplate.js">
import { formatPrice } from "./format.js";
import { channelLabel, formatLagosDateTime } from "./receipt.js";

const esc = (s) => String(s ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]);

/**
 * The kitchen alert for a paid order. Pure: the same template is previewed in the console today and will be
 * sent by the email channel when integration is approved (api/_lib/notify/channels/email.js).
 */
export function renderOrderPaidAlert(order, { consoleUrl = "" } = {}) {
  const delivery = order.fulfilment === "delivery";
  const when = formatLagosDateTime(order.payment.paidAt);
  const subject = `New paid order ${order.code} · ${formatPrice(order.total)} · ${delivery ? "Delivery" : "Pickup"}`;
  const where = delivery ? `${order.zone?.name ? `${order.zone.name} — ` : ""}${order.customer.address}` : "Pickup at the restaurant";

  const text = [
    `NEW PAID ORDER ${order.code}`,
    `${when.full} · ${channelLabel(order.payment.channel)}`,
    "",
    ...order.items.map((i) => `${i.quantity}x ${i.name} — ${formatPrice(i.lineTotal)}`),
    "",
    `Items ${formatPrice(order.subtotal)}${order.deliveryFee ? ` · Delivery ${formatPrice(order.deliveryFee)}` : ""}${order.serviceFee ? ` · Service fee ${formatPrice(order.serviceFee)}` : ""}`,
    `TOTAL ${formatPrice(order.total)}`,
    "",
    `${delivery ? "DELIVER TO" : "PICKUP"}: ${where}`,
    `Customer: ${order.customer.name} · +${order.customer.phone}`,
    order.customer.note ? `Note: ${order.customer.note}` : "",
    consoleUrl ? `\nOpen in console: ${consoleUrl}` : "",
  ].filter((l) => l !== "").join("\n");

