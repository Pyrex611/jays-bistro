          <div className="min-w-0">
            <h2 className="font-display text-base font-extrabold text-leaf-800">{title}</h2>
            {subtitle && <p className="text-xs text-ink-500">{subtitle}</p>}
          </div>
        </div>
        {badge}
      </div>
      {children}
    </section>
