<file path="src/components/invoice/InvoicePending.jsx">
import { useEffect, useState } from "react";
import { Bike, Clock, Lock, RefreshCw, Store } from "lucide-react";
import { Field } from "../ui/FormField.jsx";
import { inputClass } from "../ui/formStyles.js";
import { api } from "../../services/api.js";
import { loadCustomer, saveCustomer } from "../../lib/cartStorage.js";
import { activeZones, computeTotals } from "../../lib/pricing.js";
import { formatPrice } from "../../lib/format.js";
import { timeLeft } from "../../lib/receipt.js";

/** An unpaid invoice (usually opened from the WhatsApp link): review, choose pickup/delivery, pay with Paystack. */
export default function InvoicePending({ invoice, settings, confirming, gaveUp, onRefresh }) {
  const [now, setNow] = useState(() => Date.now());
  const [customer, setCustomer] = useState(() => ({ ...loadCustomer(), note: "" }));
  const [fulfilment, setFulfilment] = useState(invoice.fulfilment === "delivery" && settings.deliveryEnabled ? "delivery" : "pickup");
  const [zoneId, setZoneId] = useState(invoice.zone?.id ?? "");
  const [busy, setBusy] = useState(false);
  const [error, setError] = useState("");
  const [fields, setFields] = useState({});

  useEffect(() => {
    const t = setInterval(() => setNow(Date.now()), 30_000);
    return () => clearInterval(t);
  }, []);

  const set = (key) => (e) => setCustomer((c) => ({ ...c, [key]: e.target.value }));
  const zones = activeZones(settings);
  const totals = computeTotals(invoice.items, fulfilment, settings, { zoneId, payOnline: true });
  const left = timeLeft(invoice.expiresAt, now);
  const delivery = fulfilment === "delivery";

  const pay = async (e) => {
    e.preventDefault();
    setBusy(true);
    setError("");
    setFields({});
    try {
      saveCustomer(customer);
      const res = await api.payInvoice(invoice.id, { fulfilment, zoneId, customer });
      window.location.assign(res.authorizationUrl);
    } catch (err) {
      setFields(err.data?.fields ?? {});
      setError(err.status === 422 ? "" : err.message);
      setBusy(false);
    }
  };

  return (
    <div className="rounded-3xl bg-cream-50 p-6 text-ink-900 shadow-card">
      <div className="flex items-start justify-between">
        <div>
          <p className="text-[10px] font-bold uppercase tracking-[0.25em] text-ink-500">Invoice</p>
          <p className="font-display text-2xl font-black text-leaf-800">{invoice.code}</p>
        </div>
        <span className="inline-flex items-center gap-1 rounded-full bg-apricot-200 px-2.5 py-1 text-[11px] font-bold text-sun-900"><Clock size={12} />{left ? `Valid for ${left}` : "Expiring"}</span>
      </div>

      {(confirming || gaveUp) && (
        <div role="status" className="mt-4 flex items-start gap-2 rounded-xl bg-sage-100 p-3 text-xs font-semibold text-leaf-900">
          {confirming ? <span className="mt-0.5 h-4 w-4 flex-shrink-0 animate-spin rounded-full border-2 border-leaf-300 border-t-leaf-700" /> : <RefreshCw size={14} className="mt-0.5 flex-shrink-0" />}
          <div>
            {confirming ? "Confirming your payment with Paystack…" : "We haven't received confirmation yet. If you've paid, your receipt will appear here shortly."}
            {gaveUp && <button type="button" onClick={onRefresh} className="mt-1 block font-bold underline underline-offset-4">Check again</button>}
          </div>
        </div>
      )}

      <ul className="mt-5 space-y-2.5 border-y border-dashed border-ink-300 py-4 text-sm">
        {invoice.items.map((it) => (
          <li key={it.id} className="flex items-baseline justify-between gap-3">
            <span><span className="font-bold tabular-nums">{it.quantity}×</span> {it.name}</span>
            <span className="font-semibold tabular-nums">{formatPrice(it.unitPrice * it.quantity)}</span>
          </li>
        ))}
      </ul>

      <form onSubmit={pay} noValidate className="mt-5 space-y-4">
        <fieldset>
          <legend className="mb-1.5 text-xs font-bold text-ink-700">Pickup or delivery?</legend>
          <div className="grid grid-cols-2 gap-2">
            {[{ key: "pickup", label: "Pickup", sub: "Free", icon: Store, on: true }, { key: "delivery", label: "Delivery", sub: zones.length ? `From ${formatPrice(Math.min(...zones.map((z) => z.fee)))}` : settings.deliveryFee > 0 ? `+ ${formatPrice(settings.deliveryFee)}` : "Fee on arrival", icon: Bike, on: settings.deliveryEnabled }]
              .filter((o) => o.on)
              .map(({ key, label, sub, icon: Icon }) => (
                <label key={key} className={`flex cursor-pointer items-center gap-2 rounded-xl border-2 p-3 transition ${fulfilment === key ? "border-leaf-700 bg-sage-100" : "border-cream-300 bg-cream-50"}`}>
                  <input type="radio" name="fulfilment" value={key} checked={fulfilment === key} onChange={() => setFulfilment(key)} className="sr-only" />
                  <Icon size={18} className="text-leaf-700" aria-hidden="true" />
                  <span className="leading-tight"><span className="block text-sm font-bold">{label}</span><span className="text-[11px] text-ink-500">{sub}</span></span>
                </label>
              ))}
          </div>
        </fieldset>
        {delivery && zones.length > 0 && (
          <Field id="iv-zone" label="Delivery area" error={fields.zone}>
            <select id="iv-zone" value={zoneId} onChange={(e) => setZoneId(e.target.value)} className={inputClass(fields.zone)}>
              <option value="">Choose your area…</option>
              {zones.map((z) => <option key={z.id} value={z.id}>{z.name} · {formatPrice(z.fee)}</option>)}
            </select>
          </Field>
        )}
        <Field id="iv-name" label="Your name" error={fields.name}><input id="iv-name" className={inputClass(fields.name)} value={customer.name} onChange={set("name")} autoComplete="name" /></Field>
        <Field id="iv-phone" label="Phone number" error={fields.phone}><input id="iv-phone" className={inputClass(fields.phone)} value={customer.phone} onChange={set("phone")} type="tel" inputMode="tel" autoComplete="tel" /></Field>
        <Field id="iv-email" label="Email" error={fields.email} hint="Your receipt is sent here."><input id="iv-email" className={inputClass(fields.email)} value={customer.email} onChange={set("email")} type="email" inputMode="email" autoComplete="email" /></Field>
        {delivery && <Field id="iv-address" label="Delivery address" error={fields.address}><textarea id="iv-address" rows={2} className={`${inputClass(fields.address)} h-auto py-3`} value={customer.address} onChange={set("address")} autoComplete="street-address" /></Field>}

        <dl className="space-y-1 border-t border-dashed border-ink-300 pt-4 text-sm">
          <div className="flex justify-between text-ink-600"><dt>Items</dt><dd className="tabular-nums">{formatPrice(totals.subtotal)}</dd></div>
          {delivery && <div className="flex justify-between text-ink-600"><dt>Delivery</dt><dd>{totals.zoneRequired ? "Choose area" : totals.deliveryFee > 0 ? formatPrice(totals.deliveryFee) : zones.length || totals.freeDelivery ? "Free" : "Pay rider on arrival"}</dd></div>}
          {totals.serviceFee > 0 && <div className="flex justify-between text-ink-600"><dt>Online payment fee</dt><dd className="tabular-nums">{formatPrice(totals.serviceFee)}</dd></div>}
          <div className="flex justify-between text-base font-extrabold"><dt>Total</dt><dd className="tabular-nums">{formatPrice(totals.total)}</dd></div>
        </dl>
        {error && <p role="alert" className="rounded-lg bg-red-50 px-3 py-2 text-xs font-semibold text-red-700">{error}</p>}
        {!settings.acceptingOrders && <p role="alert" className="rounded-lg bg-sun-100 px-3 py-2 text-xs font-semibold text-sun-900">We&apos;re not taking orders right now.</p>}
        <button type="submit" disabled={busy || !settings.acceptingOrders || totals.belowMinimum} className="h-14 w-full rounded-full bg-leaf-700 text-sm font-bold uppercase tracking-widest text-white transition hover:bg-leaf-800 disabled:opacity-60">
          {busy ? "Opening Paystack…" : `Pay ${formatPrice(totals.total)}`}
        </button>
        <p className="flex items-center justify-center gap-1 text-[11px] text-ink-500"><Lock size={11} aria-hidden="true" /> Secured by Paystack · card, bank transfer or USSD</p>
      </form>
    </div>
  );
}
</file>

<file path="src/components/invoice/Receipt.jsx">
import { useState } from "react";
import { Bike, Printer, Share2, Store } from "lucide-react";
import WhatsAppIcon from "../icons/WhatsAppIcon.jsx";
import { SITE, assetUrl } from "../../config/site.js";
import { formatPrice } from "../../lib/format.js";
import { channelLabel, formatLagosDateTime, isTestMode } from "../../lib/receipt.js";

const Rule = () => <div className="my-4 border-t border-dashed border-ink-300" aria-hidden="true" />;

/** The receipt "paper": cream card, torn bottom edge, PAID stamp. Prints cleanly (Save as PDF). */
export default function Receipt({ receipt, mode, whatsapp = SITE.whatsappNumber }) {
  const [copied, setCopied] = useState(false);
  const when = formatLagosDateTime(receipt.payment.paidAt);
  const delivery = receipt.fulfilment === "delivery";
  const url = typeof window === "undefined" ? "" : window.location.origin + window.location.pathname;
  const waText = `Hello Jay's Bistro, I've paid for order ${receipt.code} (${formatPrice(receipt.total)}). ${delivery ? "Delivery" : "Pickup"} for ${receipt.customer.name}.`;

  const share = async () => {
    const data = { title: `Receipt ${receipt.code} · ${SITE.name}`, text: `My Jay's Bistro receipt ${receipt.code} — ${formatPrice(receipt.total)}`, url };
    try {
      if (navigator.share) await navigator.share(data);
      else {
        await navigator.clipboard.writeText(url);
        setCopied(true);
        setTimeout(() => setCopied(false), 2000);
      }
    } catch {
      /* user cancelled */
    }
  };

  return (
    <div>
      <div className="print-paper receipt-edge-bottom relative bg-cream-50 px-6 pb-8 pt-7 text-ink-900 shadow-card">
        <span
          className="pointer-events-none absolute right-5 top-24 -rotate-12 rounded-md border-[3px] border-sun-500 px-2.5 py-0.5 font-display text-lg font-black tracking-widest text-sun-500 opacity-90"
          aria-label={isTestMode(mode) ? (mode === "demo" ? "Demo payment" : "Test payment") : "Paid"}
        >
          {isTestMode(mode) ? (mode === "demo" ? "DEMO" : "TEST") : "PAID"}
        </span>

        <div className="text-center">
          <img src={assetUrl(SITE.logoPath)} alt="" width="56" height="56" className="mx-auto h-14 w-14 rounded-full border border-cream-300 object-cover" />
          <p className="mt-2 font-display text-lg font-extrabold text-leaf-700">{SITE.name}</p>
          <p className="text-[11px] text-ink-500">{SITE.address.street}, {SITE.address.locality}, {SITE.address.region}</p>
        </div>

        <Rule />
        <div className="flex items-end justify-between">
          <div>
            <p className="text-[10px] font-bold uppercase tracking-[0.25em] text-ink-500">Receipt</p>
            <p className="font-display text-2xl font-black tracking-wide text-leaf-800">{receipt.code}</p>
          </div>
          <p className="text-right text-xs leading-snug text-ink-600">{when.date}<br />{when.time}</p>
        </div>
        <Rule />

        <ul className="space-y-2.5 text-sm">
          {receipt.items.map((it) => (
            <li key={it.id} className="flex items-baseline justify-between gap-3">
              <span className="min-w-0"><span className="font-bold tabular-nums">{it.quantity}×</span> {it.name}</span>
              <span className="flex-shrink-0 font-semibold tabular-nums">{formatPrice(it.lineTotal)}</span>
            </li>
          ))}
        </ul>

        <Rule />
        <dl className="space-y-1 text-sm">
          <div className="flex justify-between text-ink-600"><dt>Subtotal</dt><dd className="tabular-nums">{formatPrice(receipt.subtotal)}</dd></div>
          {delivery && <div className="flex justify-between text-ink-600"><dt>Delivery{receipt.zone ? ` · ${receipt.zone.name}` : ""}</dt><dd className="tabular-nums">{receipt.deliveryFee > 0 ? formatPrice(receipt.deliveryFee) : receipt.zone ? "Free" : "Pay rider on arrival"}</dd></div>}
          {receipt.serviceFee > 0 && <div className="flex justify-between text-ink-600"><dt>Online payment fee</dt><dd className="tabular-nums">{formatPrice(receipt.serviceFee)}</dd></div>}
          <div className="flex items-baseline justify-between pt-2 text-leaf-800"><dt className="text-sm font-bold uppercase tracking-wider">Total paid</dt><dd className="font-display text-2xl font-black tabular-nums">{formatPrice(receipt.total)}</dd></div>
        </dl>

        <Rule />
        <dl className="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1.5 text-xs">
          <dt className="text-ink-500">Paid with</dt><dd className="text-right font-semibold">{channelLabel(receipt.payment.channel)} · Paystack</dd>
          <dt className="text-ink-500">Reference</dt><dd className="break-all text-right font-mono text-[11px]">{receipt.payment.reference}</dd>
          <dt className="text-ink-500">Customer</dt><dd className="text-right font-semibold">{receipt.customer.name}</dd>
          <dt className="text-ink-500">{delivery ? "Deliver to" : "Pickup at"}</dt>
          <dd className="text-right font-semibold">{delivery ? `${receipt.zone?.name ? `${receipt.zone.name} — ` : ""}${receipt.customer.address}` : `${SITE.address.street}, ${SITE.address.locality}`}</dd>
          {receipt.customer.note && (<><dt className="text-ink-500">Note</dt><dd className="text-right">{receipt.customer.note}</dd></>)}
        </dl>

        <p className="mt-6 text-center text-xs text-ink-500">Thank you for choosing Jay&apos;s Bistro 💚🧡</p>
      </div>

      <div className="no-print mt-5 grid grid-cols-3 gap-2">
        <button type="button" onClick={() => window.print()} className="flex flex-col items-center gap-1 rounded-2xl bg-cream-50 py-3 text-xs font-bold text-leaf-900 shadow-sm ring-1 ring-cream-300 transition hover:bg-white"><Printer size={18} />Save PDF</button>
        <button type="button" onClick={share} className="flex flex-col items-center gap-1 rounded-2xl bg-cream-50 py-3 text-xs font-bold text-leaf-900 shadow-sm ring-1 ring-cream-300 transition hover:bg-white"><Share2 size={18} />{copied ? "Link copied" : "Share"}</button>
        <a href={`https://wa.me/${whatsapp}?text=${encodeURIComponent(waText)}`} target="_blank" rel="noopener noreferrer" className="flex flex-col items-center gap-1 rounded-2xl bg-[#25D366] py-3 text-xs font-bold text-white transition hover:brightness-95"><WhatsAppIcon size={18} />Message us</a>
      </div>
    </div>
  );
}

/** "What happens next" card shown under the receipt. */
export function NextSteps({ receipt }) {
  const delivery = receipt.fulfilment === "delivery";
  const Icon = delivery ? Bike : Store;
  const range = delivery ? receipt.zone?.etaMins : receipt.prepMins;
  const eta = range?.[1] ? `${range[0]}–${range[1]} min` : "";
  return (
    <div className="no-print mt-5 flex gap-3 rounded-2xl bg-cream-50 p-4 text-ink-900 shadow-sm ring-1 ring-cream-300">
      <Icon size={22} className="mt-0.5 flex-shrink-0 text-leaf-700" aria-hidden="true" />
      <div className="text-sm leading-relaxed">
        <p className="font-bold text-leaf-800">{delivery ? "We're getting your order ready" : "Your order is being prepared"}</p>
        <p className="text-ink-600">
          {delivery
            ? `We'll call ${receipt.customer.phone ? `+${receipt.customer.phone}` : "you"} when the rider is on the way.`
            : <>Show code <span className="font-bold text-leaf-800">{receipt.code}</span> when you arrive to collect.</>}
          {eta && <> Estimated {delivery ? "delivery" : "ready time"}: <span className="font-semibold">{eta}</span>.</>}
        </p>
      </div>
    </div>
  );
}
</file>

