<file path="src/lib/invoiceModel.js">
import { computeTotals, toKobo } from "./pricing.js";

/**
 * Pure invoice/receipt model. The API (api/_lib/invoices.js) and the browser demo backend (src/demo) both build
 * invoices, register payment attempts and issue receipts through these functions, so they can never disagree on money.
 */

export const INVOICE_TTL_MS = 24 * 60 * 60 * 1000;

export const zoneSnapshot = (zone) => (zone ? { id: zone.id, name: zone.name, fee: zone.fee, etaMins: zone.etaMins } : null);
export const isExpired = (record, now = Date.now()) => record.status === "pending" && new Date(record.expiresAt).getTime() < now;

/** @param {{ id:string, code:string, lines:Array<{item:object, quantity:number}>, fulfilment:string, channel:string, settings:object, zoneId?:string|null, customer?:object, now?:Date }} input */
export function buildInvoiceRecord({ id, code, lines, fulfilment, channel, settings, zoneId = null, customer = {}, now = new Date() }) {
  const items = lines.map(({ item, quantity }) => ({ id: item.id, name: item.name, unitPrice: item.price, quantity, lineTotal: item.price * quantity }));
  const totals = computeTotals(items, fulfilment, settings, { zoneId });
  return {
    id,
    code,
    status: "pending",
    channel,
    createdAt: now.toISOString(),
    expiresAt: new Date(now.getTime() + INVOICE_TTL_MS).toISOString(),
    items,
    subtotal: totals.subtotal,
    deliveryFee: totals.deliveryFee,
    serviceFee: 0, // added when the customer pays online
    total: totals.total,
    fulfilment,
    zone: zoneSnapshot(totals.zone),
    prepMins: settings.prepMins,
    customer,
    attempts: [],
  };
}

/** Re-prices for the chosen fulfilment/zone (adding the online-payment fee) and registers a payment attempt. Mutates `record`. */
export function applyAttempt(record, { reference, fulfilment, zoneId = null, settings, customer, now = new Date() }) {
  const totals = computeTotals(record.items, fulfilment, settings, { zoneId, payOnline: true });
  const zone = zoneSnapshot(totals.zone);
  record.fulfilment = fulfilment;
  record.deliveryFee = totals.deliveryFee;
  record.serviceFee = totals.serviceFee;
  record.total = totals.total;
  record.zone = zone;
  record.customer = customer;
  record.attempts.push({ reference, at: now.toISOString(), fulfilment, zone, deliveryFee: totals.deliveryFee, serviceFee: totals.serviceFee, total: totals.total, amountKobo: toKobo(totals.total) });
  return { record, reference, amountKobo: toKobo(totals.total), totals };
}

/**
 * A verified payment → receipt, or null if the verification doesn't match exactly what we asked to be charged.
 * `verification`: { status, amountKobo, currency?, channel?, paidAt? }
 */
export function buildReceipt(record, reference, verification, mode) {
  if (record.status === "paid") return record;
  const attempt = record.attempts.find((a) => a.reference === reference);
  if (!attempt || verification.status !== "success") return null;
  if ((verification.currency ?? "NGN") !== "NGN") return null;
  if (verification.amountKobo !== attempt.amountKobo) return null;
  return {
    ...record,
    status: "paid",
    fulfilment: attempt.fulfilment,
    zone: attempt.zone ?? null,
    deliveryFee: attempt.deliveryFee,
    serviceFee: attempt.serviceFee ?? 0,
    total: attempt.total,
    payment: { reference, channel: verification.channel ?? "card", paidAt: verification.paidAt ?? new Date().toISOString(), amount: attempt.total, currency: "NGN", mode },
  };
}
</file>

<file path="src/lib/orderLines.js">
/** Validate the cart the browser sent against the live menu. Prices always come from the menu, never from the client. */
export function resolveOrderLines(rawItems, doc) {
  if (!Array.isArray(rawItems) || rawItems.length === 0) return { ok: false, error: "Your tray is empty." };
  if (rawItems.length > 40) return { ok: false, error: "Too many different items in one order." };

  const byId = new Map(doc.items.filter((i) => i.isActive !== false).map((i) => [i.id, i]));
  const merged = new Map();
  for (const raw of rawItems) {
    const id = Number(raw?.id);
    const quantity = Math.trunc(Number(raw?.quantity));
    if (!Number.isInteger(id) || !byId.has(id)) return { ok: false, error: "An item in your tray is no longer on the menu.", code: "unknown_item" };
    if (!Number.isInteger(quantity) || quantity < 1 || quantity > 20) return { ok: false, error: "Quantities must be between 1 and 20." };
    merged.set(id, Math.min(20, (merged.get(id) ?? 0) + quantity));
  }

  const lines = [...merged].map(([id, quantity]) => ({ item: byId.get(id), quantity }));
  const soldOut = lines.filter((l) => l.item.isAvailable === false).map((l) => l.item.name);
  if (soldOut.length) return { ok: false, error: `Sold out today: ${soldOut.join(", ")}. Please remove ${soldOut.length > 1 ? "them" : "it"} to continue.`, code: "sold_out", soldOut };

  return { ok: true, lines };
}
</file>

<file path="src/lib/orderStats.js">
/** Sales statistics from paid receipts. Pure: used by the API and by the browser demo backend. */

const lagosDay = (iso) => new Intl.DateTimeFormat("en-CA", { timeZone: "Africa/Lagos" }).format(new Date(iso));

export function summarize(receipts, days, now = new Date()) {
  const revenue = receipts.reduce((s, r) => s + r.total, 0);
  const byItem = new Map();
  for (const r of receipts) for (const it of r.items) {
    const cur = byItem.get(it.id) ?? { id: it.id, name: it.name, units: 0, revenue: 0 };
    cur.units += it.quantity;
    cur.revenue += it.lineTotal;
    byItem.set(it.id, cur);
  }
  const daily = new Map();
  for (let i = days - 1; i >= 0; i -= 1) daily.set(lagosDay(new Date(now.getTime() - i * 86_400_000).toISOString()), { revenue: 0, orders: 0 });
  for (const r of receipts) {
    const d = daily.get(lagosDay(r.payment.paidAt));
    if (d) { d.revenue += r.total; d.orders += 1; }
  }
  return {
    kpis: { revenue, orders: receipts.length, averageOrder: receipts.length ? Math.round(revenue / receipts.length) : 0 },
    daily: [...daily].map(([date, v]) => ({ date, ...v })),
    topItems: [...byItem.values()].sort((a, b) => b.units - a.units).slice(0, 8),
  };
}


/** Orders per Lagos hour of day (0–23) and simple splits: handy for "peak hours" and mix charts. */
export function breakdowns(receipts) {
  const hours = Array.from({ length: 24 }, (_, h) => ({ hour: h, orders: 0, revenue: 0 }));
  const split = { pickup: 0, delivery: 0 };
  const channels = {};
  for (const r of receipts) {
    const hour = Number(new Intl.DateTimeFormat("en-GB", { timeZone: "Africa/Lagos", hour: "2-digit", hour12: false }).format(new Date(r.payment.paidAt))) % 24;
    hours[hour].orders += 1;
    hours[hour].revenue += r.total;
    split[r.fulfilment === "delivery" ? "delivery" : "pickup"] += 1;
    channels[r.payment.channel] = (channels[r.payment.channel] ?? 0) + 1;
  }
  return { hours, split, channels };
}
</file>

