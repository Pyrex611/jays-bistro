<file path="src/hooks/useCart.js">
import { useCallback, useEffect, useMemo, useReducer, useState } from "react";
import { cartCount, cartReducer, cartTotal, resolveCartLines } from "../lib/cart.js";
import { loadCart, saveCart } from "../lib/cartStorage.js";

/**
 * Cart state for the storefront (persisted on this device). `bump` increments whenever something is added,
 * so the header badge can replay its pop animation (use it as a React key).
 */
export function useCart(byId) {
  const [cart, dispatch] = useReducer(cartReducer, null, loadCart);
  const [bump, setBump] = useState(0);

  useEffect(() => saveCart(cart), [cart]);

  const lines = useMemo(() => resolveCartLines(cart, byId), [cart, byId]);
  const count = useMemo(() => cartCount(lines), [lines]);
  const subtotal = useMemo(() => cartTotal(lines), [lines]);
  const quantities = useMemo(() => Object.fromEntries(lines.map((l) => [l.item.id, l.quantity])), [lines]);
  const unavailable = useMemo(() => lines.filter((l) => l.item.isAvailable === false), [lines]);

  const add = useCallback((id, quantity = 1) => {
    dispatch({ type: "add", id, quantity });
    setBump((b) => b + 1);
  }, []);
  const decrement = useCallback((id) => dispatch({ type: "remove", id, quantity: 1 }), []);
  const removeLine = useCallback((id) => dispatch({ type: "removeLine", id }), []);
  const clear = useCallback(() => dispatch({ type: "clear" }), []);

  /** Apply already-sanitised chatbot actions: [{ action: 'add'|'remove', id, quantity }]. */
  const applyActions = useCallback((actions) => {
    if (!actions.length) return;
    actions.forEach((a) => dispatch({ type: a.action, id: a.id, quantity: a.quantity }));
    setBump((b) => b + 1);
  }, []);

  return { lines, count, subtotal, quantities, unavailable, bump, add, decrement, removeLine, clear, applyActions };
}
</file>

<file path="src/hooks/useCheckout.js">
import { useCallback, useState } from "react";
import { api } from "../services/api.js";
import { buildWhatsAppLink } from "../lib/whatsapp.js";
import { saveCustomer } from "../lib/cartStorage.js";
import { track } from "../lib/track.js";

const payload = (lines) => lines.map((l) => ({ id: l.item.id, quantity: l.quantity }));

/**
 * Checkout actions for the tray.
 *   payOnline()      → creates an invoice + Paystack payment, then sends the browser to Paystack's hosted page.
 *   shareOnWhatsApp()→ creates an expiring invoice and opens WhatsApp with the order + invoice link
 *                      (falls back to a plain message if the invoice can't be created, so ordering never breaks).
 */
export function useCheckout({ lines, total, whatsapp }) {
  const [busy, setBusy] = useState(null); // "pay" | "whatsapp" | null
  const [error, setError] = useState("");
  const [fieldErrors, setFieldErrors] = useState({});

  const payOnline = useCallback(
    async ({ customer, fulfilment, zoneId }) => {
      setBusy("pay");
      setError("");
      setFieldErrors({});
      try {
        saveCustomer(customer);
        track("checkout_click", { channel: "paystack", total });
        const res = await api.checkout({ items: payload(lines), fulfilment, zoneId, intent: "pay", customer });
        window.location.assign(res.authorizationUrl); // Paystack's hosted page (or the demo payment page)
        return true; // leaving the page; keep the spinner up
      } catch (e) {
        setFieldErrors(e.data?.fields ?? {});
        setError(e.status === 422 ? "" : e.message);
        setBusy(null);
        return false;
      }
    },
    [lines, total],
  );

  const shareOnWhatsApp = useCallback(
    async ({ fulfilment = "pickup" } = {}) => {
      setBusy("whatsapp");
      setError("");
      track("checkout_click", { channel: "whatsapp", total });
      // Open the tab synchronously (inside the tap) so iOS Safari doesn't block it, then point it at WhatsApp.
      const tab = window.open("", "_blank");
      if (tab) tab.opener = null;
      const go = (url) => (tab ? (tab.location.href = url) : window.location.assign(url));

      try {
        const inv = await api.checkout({ items: payload(lines), fulfilment, intent: "invoice" });
        go(buildWhatsAppLink(lines, whatsapp, { invoiceUrl: inv.invoiceUrl, total: inv.total }));
      } catch (e) {
        // Business rules (paused store, sold out, minimum order) must be shown, not bypassed.
        if (e.status && [403, 409, 400].includes(e.status) && e.data?.code) {
          tab?.close();
          setError(e.message);
        } else {
          go(buildWhatsAppLink(lines, whatsapp)); // network trouble: plain WhatsApp order still works
        }
      } finally {
        setBusy(null);
      }
    },
    [lines, total, whatsapp],
  );

  const reset = useCallback(() => {
    setError("");
    setFieldErrors({});
  }, []);

  return { busy, error, fieldErrors, payOnline, shareOnWhatsApp, reset };
}
</file>

<file path="src/lib/chat.js">
import { MAX_QTY_PER_ITEM } from "./cart.js";

/**
 * Pure helpers for the AI concierge. Network access lives in services/concierge.js.
 */

export function buildSystemPrompt(menuItems, cartLines) {
  const menu = menuItems.map((i) => `ID ${i.id}: ${i.name} (₦${i.price})${i.isAvailable === false ? " [SOLD OUT today - do not add]" : ""}`).join("\n");
  const cart = cartLines.length
    ? cartLines.map((l) => `ID ${l.item.id}: ${l.item.name} (x${l.quantity})`).join("\n")
    : "Empty";

  return `You are Jay's Bistro's virtual concierge.
Your job is to assist customers with their orders, answer menu questions, and manage their cart. Keep responses short, elegant and very friendly.
Only recommend and add items that appear in the menu below. Never add an item marked SOLD OUT; suggest an alternative instead.

Menu:
${menu}

Current Cart:
${cart}

You MUST respond ONLY with a JSON object in this exact format. Do not use markdown code fences. Only a pure JSON string.
{
  "message": "Your conversational reply here",
  "actions": [{"action": "add" | "remove", "id": number, "quantity": number}]
}
If no cart changes are needed, actions should be [].`;
}

/** Map UI chat history + the new user message to Gemini `contents`. */
export function buildContents(history, userText) {
  const past = history.map((msg) => ({
    role: msg.role === "user" ? "user" : "model",
    parts: [{ text: msg.role === "model" ? JSON.stringify({ message: msg.text, actions: [] }) : msg.text }],
  }));
  return [...past, { role: "user", parts: [{ text: userText }] }];
}

/** Parse the model's raw text. Returns { message, actions } or null if it is not valid. */
export function parseModelReply(rawText) {
  try {
    const clean = String(rawText ?? "")
      .replace(/```json/gi, "")
      .replace(/```/g, "")
      .trim();
    const parsed = JSON.parse(clean);
    if (!parsed || typeof parsed.message !== "string") return null;
    return { message: parsed.message, actions: Array.isArray(parsed.actions) ? parsed.actions : [] };
  } catch {
    return null;
  }
}

/**
 * Never trust model output: keep only well-formed add/remove actions for items that exist.
 * Quantities are clamped to 1..MAX_QTY_PER_ITEM.
 */
export function sanitizeActions(actions, byId) {
  if (!Array.isArray(actions)) return [];
  return actions
    .map((a) => {
      if (!a || (a.action !== "add" && a.action !== "remove")) return null;
      const id = Number(a.id);
      if (!Number.isInteger(id) || !byId[id]) return null;
      if (a.action === "add" && byId[id].isAvailable === false) return null;
      const qty = Math.trunc(Number(a.quantity ?? 1));
      if (!Number.isFinite(qty) || qty < 1) return null;
      return { action: a.action, id, quantity: Math.min(qty, MAX_QTY_PER_ITEM) };
    })
    .filter(Boolean);
}
</file>

<file path="src/lib/hours.js">
/** Opening-hours helper (Africa/Lagos, no DST). Pure: pass `now` for tests. */

const DAY_NAMES = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
const TZ = "Africa/Lagos";

const toMinutes = (hhmm) => {
  const [h, m] = hhmm.split(":").map(Number);
  return h * 60 + m;
};

export const formatClock = (hhmm) => {
  const [h, m] = hhmm.split(":").map(Number);
  const suffix = h >= 12 ? "PM" : "AM";
  const hour = h % 12 === 0 ? 12 : h % 12;
  return m === 0 ? `${hour} ${suffix}` : `${hour}:${String(m).padStart(2, "0")} ${suffix}`;
};

/** Accepts the settings shape ({day, open, close, closed}) or the legacy shape ({days:[…], opens, closes}). */
export function toSlots(hours) {
  return (hours ?? []).flatMap((h) =>
    h.days
      ? [{ days: h.days, opens: h.opens, closes: h.closes }]
      : h.closed ? [] : [{ days: [h.day], opens: h.open, closes: h.close }],
  );
}

function lagosParts(now) {
  const parts = new Intl.DateTimeFormat("en-US", { timeZone: TZ, weekday: "long", hour: "2-digit", minute: "2-digit", hour12: false }).formatToParts(now);
  const get = (type) => parts.find((p) => p.type === type)?.value;
  const hour = Number(get("hour")) % 24;
  return { dayIndex: DAY_NAMES.indexOf(get("weekday")), minutes: hour * 60 + Number(get("minute")) };
}

const lagosDate = (when) => new Intl.DateTimeFormat("en-CA", { timeZone: TZ }).format(when);
const slotForDay = (slots, dayName) => slots.find((h) => h.days.includes(dayName));

/**
 * @returns {{open:boolean, label:string}}
 */
export function getOpenStatus(hours, now = new Date(), closures = []) {
  const slots = toSlots(hours);
  const { dayIndex, minutes } = lagosParts(now);
  const closureOn = (when) => closures.find((c) => c.date === lagosDate(when));

  const todayClosure = closureOn(now);
  const today = todayClosure ? null : slotForDay(slots, DAY_NAMES[dayIndex]);

  if (todayClosure) {
    // fall through to "next opening" below, but say why we're closed today
  } else if (today && minutes >= toMinutes(today.opens) && minutes < toMinutes(today.closes)) {
    return { open: true, label: `Open · until ${formatClock(today.closes)}` };
  } else if (today && minutes < toMinutes(today.opens)) {
    return { open: false, label: `Closed · opens today at ${formatClock(today.opens)}` };
  }

  for (let step = 1; step <= 14; step += 1) {
    const when = new Date(now.getTime() + step * 86_400_000);
    if (closureOn(when)) continue;
    const name = DAY_NAMES[(dayIndex + step) % 7];
    const slot = slotForDay(slots, name);
    if (slot) {
      const label = step === 1 ? "tomorrow" : name.slice(0, 3);
      return { open: false, label: `${todayClosure ? "Closed today" : "Closed"} · opens ${label} at ${formatClock(slot.opens)}` };
    }
  }
  return { open: false, label: "Closed" };
}
</file>

