                </span>
            </div>

            {/* Cart Icon (Pulsing) */}
            <motion.div 
                className="relative cursor-pointer"
                key={cartPulseKey} 
                initial={{ scale: 1 }}
                animate={cartPulseKey !== 0 ? { scale: [1, 1.2, 0.95, 1] } : { scale: 1 }} 
