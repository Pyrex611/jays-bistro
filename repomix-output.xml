<file path="src/services/imageCompress.js">
/**
 * Browser-side image prep for menu photos: downscale, re-encode, and make sure the result fits the 1.5 MB server limit.
 * Cutouts keep transparency (WebP, or PNG on browsers that can't encode WebP, e.g. iOS Safari); photos become JPEG.
 */
const MAX_BYTES = 1_200_000;

const loadBitmap = (file) =>
  new Promise((resolve, reject) => {
    const url = URL.createObjectURL(file);
    const img = new Image();
    img.onload = () => {
      URL.revokeObjectURL(url);
      resolve(img);
    };
    img.onerror = () => {
      URL.revokeObjectURL(url);
      reject(new Error("That file couldn't be read as an image."));
    };
    img.src = url;
  });

const bytesOf = (dataUrl) => Math.floor((dataUrl.length - dataUrl.indexOf(",") - 1) * 0.75);

/** @param {File} file @param {"cutout"|"photo"} style @returns {Promise<string>} data URL */
export async function prepareImage(file, style = "photo") {
  if (!file.type.startsWith("image/")) throw new Error("Please choose an image file.");
  const img = await loadBitmap(file);

  for (const maxSide of [1000, 800, 640, 480]) {
    const scale = Math.min(1, maxSide / Math.max(img.width, img.height));
    const canvas = document.createElement("canvas");
    canvas.width = Math.max(1, Math.round(img.width * scale));
    canvas.height = Math.max(1, Math.round(img.height * scale));
    canvas.getContext("2d").drawImage(img, 0, 0, canvas.width, canvas.height);

    const dataUrl = style === "cutout" ? canvas.toDataURL("image/webp", 0.88) : canvas.toDataURL("image/jpeg", 0.84);
    if (bytesOf(dataUrl) <= MAX_BYTES) return dataUrl;
  }
  throw new Error("That image is too large to upload. Try a smaller photo.");
}
</file>

<file path="src/services/runtime.js">
/**
 * Which integrations are connected? Filled from `/api/menu` → `capabilities`.
 * Every integration (storage, payments, email, order status) has a REAL implementation and a DEMO one;
 * `isDemo()` picks per call. When Vercel Blob / Paystack / email are connected the server reports it and the demo
 * code simply stops being used. No front-end change is needed to switch over.
 */
let capabilities = null;
let demo = null; // true | false | null (not known yet)
const listeners = new Set();
let waiters = [];

const notify = () => {
  waiters.splice(0).forEach((resolve) => resolve());
  listeners.forEach((fn) => fn());
};

export const runtime = {
  get capabilities() {
    return capabilities;
  },
  setCapabilities(next) {
    capabilities = next;
    if (next) demo = next.storage === false;
    notify();
  },
  setDemo(value) {
    demo = value;
    notify();
  },
  isDemo: () => demo === true,
  isKnown: () => demo !== null,
  /** Resolves once we know, or after `timeoutMs` (then we assume the real backend). */
  whenReady(timeoutMs = 3000) {
    if (demo !== null) return Promise.resolve();
    return new Promise((resolve) => {
      const timer = setTimeout(resolve, timeoutMs);
      waiters.push(() => {
        clearTimeout(timer);
        resolve();
      });
    });
  },
  subscribe(fn) {
    listeners.add(fn);
    return () => listeners.delete(fn);
  },
  reset() {
    capabilities = null;
    demo = null;
    waiters = [];
  },
};
</file>

<file path="src/utils/helpers.js">
export const formatPrice = (p) => "₦" + p.toLocaleString();

export const generateWhatsAppLink = (cart, phoneNumber) => {
    if (cart.length === 0) return `https://wa.me/${phoneNumber}`;
    let message = "Hello Jay's Bistro, I would like to place an order:\n\n";
    let total = 0;
    cart.forEach(item => {
        const itemTotal = item.price * item.quantity;
        total += itemTotal;
        message += `▪ ${item.quantity}x ${item.name} - ${formatPrice(itemTotal)}\n`;
    });
    message += `\n*Total Order Value: ${formatPrice(total)}*`;
    return `https://wa.me/${phoneNumber}?text=${encodeURIComponent(message)}`;
};
