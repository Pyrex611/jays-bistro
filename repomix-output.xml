<file path="src/index.css">
@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  html {
    scroll-behavior: smooth;
    -webkit-text-size-adjust: 100%;
  }
  body {
    @apply bg-cream-200 font-sans text-ink-900 antialiased;
  }
  :focus-visible {
    outline: 2px solid theme("colors.sun.500");
    outline-offset: 2px;
  }
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
}

/* ── Soft pastel surfaces ("cloudy"): diagonal two-stop gradient + a white radial glow + a faint inner highlight. ── */
@layer components {
  .surface-sage {
    background-image:
      radial-gradient(120% 90% at 20% 15%, rgb(255 255 255 / 0.35), transparent 60%),
      linear-gradient(135deg, theme("colors.sage.400"), theme("colors.sage.600"));
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.3);
  }
  .surface-sage-tile {
    background-image:
      radial-gradient(120% 90% at 20% 15%, rgb(255 255 255 / 0.35), transparent 60%),
      linear-gradient(135deg, theme("colors.sage.400"), theme("colors.sage.500"));
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.3);
  }
  .surface-apricot {
    background-image:
      radial-gradient(120% 90% at 20% 15%, rgb(255 255 255 / 0.45), transparent 60%),
      linear-gradient(135deg, theme("colors.apricot.300"), theme("colors.apricot.400"));
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.35);
  }
}

@layer utilities {
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  /* Torn-paper edge for the receipt (CSS-only, no images). */
  .receipt-edge-bottom {
    --s: 10px;
    -webkit-mask: conic-gradient(from -45deg at bottom, #0000, #000 1deg 89deg, #0000 90deg) 50% / calc(var(--s) * 2) 100%;
    mask: conic-gradient(from -45deg at bottom, #0000, #000 1deg 89deg, #0000 90deg) 50% / calc(var(--s) * 2) 100%;
    padding-bottom: var(--s);
  }
  .skeleton {
    position: relative;
    overflow: hidden;
    background: theme("colors.cream.300");
  }
  .skeleton::after {
    content: "";
    position: absolute;
    inset: 0;
    transform: translateX(-100%);
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.55), transparent);
    animation: shimmer 1.4s infinite;
  }
}

/* Receipt: print / "Save as PDF" shows only the paper. */
@media print {
  body {
    background: #fff !important;
  }
  .no-print {
    display: none !important;
  }
  .print-paper {
    box-shadow: none !important;
    margin: 0 auto !important;
  }
  .receipt-edge-bottom {
    -webkit-mask: none;
    mask: none;
  }
}
