<file path="api/merchant/auth.js">
import { allow, clientIp, fail, ok, parseBody, requireAjax } from "../_lib/http.js";
import { requireStorage } from "../_lib/guard.js";
import { storageConfigured } from "../_lib/storage.js";
import {
  authenticate, clearCookieHeader, clearFailures, cookieHeader, getSession, issueToken,
  recordFailure, setPassword, throttleStatus, validateNewPassword,
} from "../_lib/auth.js";

const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

/**
 * /api/merchant/auth
 *   GET     → { authenticated, mustChangePassword }
 *   POST    { password }                        → sign in
 *   PUT     { currentPassword, newPassword }    → change password (signs everyone else out)
 *   DELETE  → sign out
 */
export default async function handler(req, res) {
  if (!allow(req, res, ["GET", "POST", "PUT", "DELETE"])) return;

  if (req.method === "GET") {
    // No storage yet → DEMO mode: the console runs on the browser-local demo backend (src/demo) with the setup password.
    if (!storageConfigured()) return ok(res, { authenticated: false, mustChangePassword: false, mode: "demo" });
    const s = await getSession(req);
    return ok(res, { authenticated: Boolean(s), mustChangePassword: Boolean(s?.bootstrap), mode: "live" });
  }

  if (!requireAjax(req, res)) return;

  if (req.method === "DELETE") return ok(res, { authenticated: false }, { "Set-Cookie": clearCookieHeader(req) });
  if (!requireStorage(res)) return;

  const body = parseBody(req);
  const ip = clientIp(req);

  if (req.method === "POST") {
    const t = await throttleStatus(ip);
    if (t.locked) return fail(res, 429, "Too many attempts. Try again later.", { retryAfter: t.retryAfter });

    await sleep(process.env.NODE_ENV === "test" ? 0 : 400); // slows guessing; negligible for the owner
    const result = await authenticate(String(body.password ?? ""));
    if (result.reason === "not_configured") return fail(res, 503, "The portal isn't set up yet (MERCHANT_BOOTSTRAP_PASSWORD is missing).");
    if (!result.ok) {
      await recordFailure(ip);
      return fail(res, 401, "That password isn't right.");
    }
    await clearFailures(ip);
    return ok(res, { authenticated: true, mustChangePassword: result.bootstrap }, { "Set-Cookie": cookieHeader(req, issueToken(result)) });
  }

  // PUT — change password (requires being signed in AND knowing the current password)
  const session = await getSession(req);
  if (!session) return fail(res, 401, "Please sign in.");
  const t = await throttleStatus(ip);
  if (t.locked) return fail(res, 429, "Too many attempts. Try again later.", { retryAfter: t.retryAfter });

  const current = await authenticate(String(body.currentPassword ?? ""));
  if (!current.ok) {
    await recordFailure(ip);
    return fail(res, 401, "Your current password isn't right.");
  }
  const problem = validateNewPassword(body.newPassword);
  if (problem) return fail(res, 400, problem);
  if (body.newPassword === body.currentPassword) return fail(res, 400, "Choose a password you haven't used.");

  const { pwv } = await setPassword(body.newPassword);
  return ok(res, { authenticated: true, mustChangePassword: false }, { "Set-Cookie": cookieHeader(req, issueToken({ pwv, bootstrap: false })) });
}
</file>

<file path="api/merchant/image.js">
import crypto from "node:crypto";
import { allow, fail, ok, parseBody, requireAjax } from "../_lib/http.js";
import { requireStorage } from "../_lib/guard.js";
import { requireMerchant } from "../_lib/auth.js";
import { getStorage } from "../_lib/storage.js";

const MAX_BYTES = 1_500_000; // the portal compresses to well under this before uploading

const sniff = (buf) => {
  if (buf.length > 12 && buf.toString("ascii", 0, 4) === "RIFF" && buf.toString("ascii", 8, 12) === "WEBP") return { ext: "webp", type: "image/webp" };
  if (buf.length > 8 && buf[0] === 0x89 && buf.toString("ascii", 1, 4) === "PNG") return { ext: "png", type: "image/png" };
  if (buf.length > 3 && buf[0] === 0xff && buf[1] === 0xd8 && buf[2] === 0xff) return { ext: "jpg", type: "image/jpeg" };
  return null;
};

/** POST /api/merchant/image { dataUrl } → { url }  (password-protected; WebP/PNG/JPEG only, ≤ 1.5 MB) */
export default async function handler(req, res) {
  if (!allow(req, res, ["POST"])) return;
  if (!requireStorage(res)) return;
  if (!requireAjax(req, res)) return;
  if (!(await requireMerchant(req, res))) return;

  const match = /^data:image\/(?:webp|png|jpeg);base64,([A-Za-z0-9+/=]+)$/.exec(String(parseBody(req).dataUrl ?? ""));
  if (!match) return fail(res, 400, "Upload a WebP, PNG or JPEG image.");

  const buffer = Buffer.from(match[1], "base64");
  if (buffer.length > MAX_BYTES) return fail(res, 413, "That image is too large. Try a smaller photo.");
  const kind = sniff(buffer); // trust the bytes, not the label
  if (!kind) return fail(res, 400, "That file doesn't look like an image.");

  const storage = getStorage();
  const key = `images/${Date.now().toString(36)}-${crypto.randomBytes(6).toString("hex")}.${kind.ext}`;
  await storage.putBinary(key, buffer, kind.type);
  return ok(res, { url: storage.publicUrl(key) });
}
</file>

<file path="api/merchant/menu.js">
import { allow, fail, ok, parseBody, requireAjax } from "../_lib/http.js";
import { requireStorage } from "../_lib/guard.js";
import { requireMerchant } from "../_lib/auth.js";
import { loadMenuDoc, MenuConflict, MenuInvalid, saveMenuDoc } from "../_lib/menuStore.js";

/**
 * /api/merchant/menu  (password-protected)
 *   GET → the current menu document (with version)
 *   PUT { doc, baseVersion } → validate + publish. 409 if someone published since baseVersion.
 */
export default async function handler(req, res) {
  if (!allow(req, res, ["GET", "PUT"])) return;
  if (!requireStorage(res)) return;
  if (!(await requireMerchant(req, res))) return;

  if (req.method === "GET") return ok(res, await loadMenuDoc({ strict: true }));

  if (!requireAjax(req, res)) return;
  const { doc, baseVersion } = parseBody(req);
  try {
    return ok(res, await saveMenuDoc(doc, baseVersion));
  } catch (e) {
    if (e instanceof MenuConflict) return fail(res, 409, e.message, { current: e.current });
    if (e instanceof MenuInvalid) return fail(res, 400, "Some fields need fixing.", { errors: e.errors });
    throw e;
  }
}
</file>

<file path="api/merchant/orders.js">
import { allow, fail, ok } from "../_lib/http.js";
import { requireStorage } from "../_lib/guard.js";
import { requireMerchant } from "../_lib/auth.js";
import { getStorage } from "../_lib/storage.js";
import { summarize } from "../../src/lib/orderStats.js";

export { summarize };

/** GET /api/merchant/orders?days=30 → paid orders + KPIs (password-protected) */
export default async function handler(req, res) {
  if (!allow(req, res, ["GET"])) return;
  if (!requireStorage(res)) return;
  if (!(await requireMerchant(req, res))) return;

  const days = Math.min(90, Math.max(1, Math.trunc(Number(req.query?.days ?? new URL(req.url, "http://x").searchParams.get("days") ?? 30)) || 30));
  const now = new Date();
  const since = now.getTime() - days * 86_400_000;
  const storage = getStorage();

  // Receipts are filed by month, so only the months in range are listed.
  const months = new Set();
  for (let t = since; t <= now.getTime() + 86_400_000; t += 20 * 86_400_000) months.add(new Date(t).toISOString().slice(0, 7).replace("-", "/"));
  months.add(now.toISOString().slice(0, 7).replace("-", "/"));

  try {
    const keys = (await Promise.all([...months].map((m) => storage.list(`receipts/${m}/`, 500)))).flat();
    const receipts = [];
    for (let i = 0; i < keys.length; i += 20) {
      const batch = await Promise.all(keys.slice(i, i + 20).map((k) => storage.getJSON(k)));
      receipts.push(...batch.filter((r) => r?.payment && new Date(r.payment.paidAt).getTime() >= since));
    }
    receipts.sort((a, b) => new Date(b.payment.paidAt) - new Date(a.payment.paidAt));
    // Test-key payments are real receipts but not real sales: excluded unless ?includeTest=1.
    const includeTest = (req.query?.includeTest ?? new URL(req.url, "http://x").searchParams.get("includeTest")) === "1";
    const isReal = (r) => r.payment.mode === "live";
    const counted = includeTest ? receipts : receipts.filter(isReal);
    return ok(res, { days, includeTest, testOrders: receipts.filter((r) => !isReal(r)).length, ...summarize(counted, days, now), orders: counted.slice(0, 100) });
  } catch {
    return fail(res, 500, "Couldn't load orders right now.");
  }
}
</file>

<file path="api/paystack/webhook.js">
import { allow, parseBody, send } from "../_lib/http.js";
import { storageConfigured } from "../_lib/storage.js";
import { idFromReference, isValidId, loadInvoice, settle } from "../_lib/invoices.js";
import { isRealPaystack, paystackMode, verifyTransaction } from "../_lib/paystack.js";

/**
 * POST /api/paystack/webhook   (set this URL in Paystack Dashboard → Settings → API Keys & Webhooks)
 *
 * Settles the invoice even if the customer closed the tab before returning to the site.
 * We do NOT trust the payload: it only tells us WHICH reference to look at; the verdict comes from
 * Paystack's verify API (server-to-server, authenticated with the secret key). Always answers 200 so Paystack doesn't retry endlessly.
 */
export default async function handler(req, res) {
  if (!allow(req, res, ["POST"])) return;
  if (!storageConfigured()) return send(res, 200, { received: false });
  try {
    const event = parseBody(req);
    const reference = event?.data?.reference;
    if (event?.event === "charge.success" && reference && isRealPaystack()) {
      const id = idFromReference(reference);
      if (isValidId(id)) {
        const record = await loadInvoice(id);
        if (record && record.status !== "paid") {
          const verification = await verifyTransaction(reference);
          await settle(record, reference, verification, { mode: paystackMode() });
        }
      }
    }
  } catch (e) {
    console.error("Webhook error:", e.message);
  }
  send(res, 200, { received: true });
}
</file>

<file path="docs/adr/0001-stack-for-sprint-1.md">
# ADR-0001: Keep Vite + React for Sprint 1

- **Status:** Accepted (re-evaluate at the Phase 2 gate)
- **Date:** 2026-10-24

## Context
The existing repo is a Vite + React 19 + Tailwind 3 SPA deployed on Vercel/GitHub Pages. Sprint 1 only changes the layout. The lead engineer's wider toolkit includes Next.js + Supabase, and the Bonti draft is planned as a Next.js build.

## Decision
Migrate the layout inside the existing Vite stack. No framework change in Sprint 1.

## Consequences
- ✅ Smallest blast radius; behaviour parity is easy to verify; no deployment changes.
- ✅ Architecture seams (`useMenu`, `lib/`, `services/`) keep a later move cheap — only `pages/` and routing are framework-specific.
- ⚠️ SPA SEO is weaker than server rendering for a local restaurant. JSON-LD and meta tags are kept, but crawlers see little HTML.

## Gate (revisit in Sprint 3)
Sprint 2 added Vercel Functions (`/api`) and stayed on Vite. The question is now only about SEO prerendering.

## Original gate text
Choose one: **(a)** stay on Vite and add build-time prerender for `/` and `/menu`; **(b)** migrate to Next.js (App Router, ISR for the menu, Route Handlers for the AI proxy). Criteria: organic search matters to the owner · cost of migration (~1 sprint, mostly routing/metadata) · single-repo simplicity for the dashboard. Record the outcome as ADR-0001a.
</file>

