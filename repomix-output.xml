<file path="src/components/merchant/ItemEditor.jsx">
import { useRef, useState } from "react";
import { Camera, Loader2, Trash2 } from "lucide-react";
import FoodImage from "../ui/FoodImage.jsx";
import { Field } from "../ui/FormField.jsx";
import { inputClass } from "../ui/formStyles.js";
import { Sheet, Switch, btnDanger, btnGhost, btnPrimary } from "./ui.jsx";
import { LIMITS } from "../../lib/menuDoc.js";
import { prepareImage } from "../../services/imageCompress.js";
import { api } from "../../services/api.js";

const PLACEHOLDER = "menu/placeholder.svg";

/** Add / edit a dish. Photo uploads immediately (compressed in the browser); everything else is saved to the draft. */
export default function ItemEditor({ item, categories, onSave, onDelete, onClose }) {
  const isNew = !item.id;
  const [form, setForm] = useState({ ...item, price: item.price ? String(item.price) : "" });
  const [errors, setErrors] = useState({});
  const [uploading, setUploading] = useState(false);
  const [uploadError, setUploadError] = useState("");
  const [confirmDelete, setConfirmDelete] = useState(false);
  const fileRef = useRef(null);

  const set = (key, value) => setForm((f) => ({ ...f, [key]: value }));

  const pick = async (file) => {
    if (!file) return;
    setUploading(true);
    setUploadError("");
    try {
      const { url } = await api.merchant.uploadImage(await prepareImage(file, form.imageStyle));
      set("image", url);
    } catch (e) {
      setUploadError(e.message);
    } finally {
      setUploading(false);
      if (fileRef.current) fileRef.current.value = "";
    }
  };

  const submit = () => {
    const next = {};
    const name = form.name.trim();
    const price = Number(form.price);
    if (name.length < 2 || name.length > LIMITS.name) next.name = `Name must be 2–${LIMITS.name} characters.`;
    if (!Number.isInteger(price) || price < 1) next.price = "Enter the price in whole naira, e.g. 1500.";
    if (!form.category) next.category = "Choose a category.";
    if (form.description.length > LIMITS.description) next.description = `Keep it under ${LIMITS.description} characters.`;
    setErrors(next);
    if (Object.keys(next).length) return;
    onSave({ ...form, name, price, description: form.description.trim(), image: form.image || PLACEHOLDER });
  };

  const cutout = form.imageStyle === "cutout";

  return (
    <Sheet
      open
      title={isNew ? "Add a dish" : "Edit dish"}
      onClose={onClose}
      footer={
        <div className="flex gap-2">
          {!isNew && (
            <button type="button" className={`${confirmDelete ? btnDanger : btnGhost} !px-4`} onClick={() => (confirmDelete ? onDelete(item.id) : setConfirmDelete(true))} aria-label="Delete dish">
              <Trash2 size={16} /> {confirmDelete ? "Tap to confirm" : ""}
            </button>
          )}
          <button type="button" className={`${btnPrimary} flex-1`} onClick={submit} disabled={uploading}>{isNew ? "Add to menu" : "Save changes"}</button>
        </div>
      }
    >
      <div className="space-y-4">
        <div>
          <p className="mb-1.5 text-xs font-bold text-ink-700">Photo</p>
          <div className="flex gap-3">
            <div className="surface-sage-tile relative h-28 w-36 flex-shrink-0 overflow-hidden rounded-2xl shadow-card">
              <FoodImage src={form.image || PLACEHOLDER} alt="Preview" variant={form.imageStyle} className={`h-full w-full ${cutout ? "p-3" : ""}`} />
              {uploading && <div className="absolute inset-0 flex items-center justify-center bg-leaf-950/60"><Loader2 className="animate-spin text-white" /></div>}
            </div>
            <div className="flex flex-1 flex-col justify-between">
              <input ref={fileRef} type="file" accept="image/*" className="sr-only" id="photo" onChange={(e) => pick(e.target.files?.[0])} />
              <label htmlFor="photo" className={`${btnGhost} cursor-pointer !py-2.5 text-xs`}><Camera size={16} /> {form.image && form.image !== PLACEHOLDER ? "Change photo" : "Add photo"}</label>
              <div role="group" aria-label="Photo style" className="grid grid-cols-2 rounded-full bg-cream-200 p-0.5 text-xs font-bold">
                {[["cutout", "Cutout"], ["photo", "Photo"]].map(([v, l]) => (
                  <button key={v} type="button" aria-pressed={form.imageStyle === v} onClick={() => set("imageStyle", v)} className={`rounded-full py-2 ${form.imageStyle === v ? "bg-leaf-700 text-white" : "text-ink-600"}`}>{l}</button>
                ))}
              </div>
            </div>
          </div>
          <p className="mt-1.5 text-[11px] text-ink-500">Cutout = dish on a transparent background (PNG). Photo = a normal picture that fills the card.</p>
          {uploadError && <p role="alert" className="mt-1 text-xs font-medium text-red-600">{uploadError}</p>}
        </div>

        <Field id="it-name" label="Name" error={errors.name}><input id="it-name" className={inputClass(errors.name)} value={form.name} onChange={(e) => set("name", e.target.value)} maxLength={LIMITS.name} placeholder="Party Jollof Rice" /></Field>
        <div className="grid grid-cols-2 gap-3">
          <Field id="it-cat" label="Category" error={errors.category}>
            <select id="it-cat" className={inputClass(errors.category)} value={form.category} onChange={(e) => set("category", e.target.value)}>
              <option value="">Choose…</option>
              {categories.map((c) => <option key={c.name} value={c.name}>{c.name}</option>)}
            </select>
          </Field>
          <Field id="it-price" label="Price (₦)" error={errors.price}><input id="it-price" className={inputClass(errors.price)} value={form.price} onChange={(e) => set("price", e.target.value.replace(/[^\d]/g, ""))} inputMode="numeric" placeholder="1500" /></Field>
        </div>
        <Field id="it-desc" label="Description" error={errors.description} hint={`${form.description.length}/${LIMITS.description}`}>
          <textarea id="it-desc" rows={3} className={`${inputClass(errors.description)} h-auto py-3`} value={form.description} onChange={(e) => set("description", e.target.value)} placeholder="Smoky, rich and slow-cooked…" />
        </Field>

        <div className="divide-y divide-cream-300 rounded-2xl border border-cream-300 bg-cream-100 px-4">
          {[
            ["isActive", "Show on menu", "Turn off to hide it without deleting."],
            ["isAvailable", "In stock today", "Turn off to show “Sold out today”."],
            ["featured", "Featured", "A highlight you can pin to the home screen."],
          ].map(([key, label, hint]) => (
            <div key={key} className="flex items-center justify-between gap-3 py-3">
              <div><p className="text-sm font-bold">{label}</p><p className="text-[11px] text-ink-500">{hint}</p></div>
              <Switch checked={Boolean(form[key])} onChange={(v) => set(key, v)} label={label} />
            </div>
          ))}
        </div>
      </div>
    </Sheet>
  );
}
</file>

<file path="src/components/merchant/LayoutManager.jsx">
import { useMemo, useState } from "react";
import { ArrowDown, ArrowUp, Plus, Trash2 } from "lucide-react";
import FoodImage from "../ui/FoodImage.jsx";
import HeroCarousel from "../storefront/HeroCarousel.jsx";
import SubHero from "../storefront/SubHero.jsx";
import { Card, Sheet, btnGhost } from "./ui.jsx";
import { LIMITS } from "../../lib/menuDoc.js";
import { buildMenuModel } from "../../lib/menuModel.js";
import { searchItems } from "../../lib/search.js";
import { formatPrice } from "../../lib/format.js";

const noop = () => {};

/** Pick a dish for a slot. */
function Picker({ items, exclude, onPick, onClose, title }) {
  const [q, setQ] = useState("");
  const options = useMemo(() => {
    const pool = items.filter((i) => i.isActive && !exclude.includes(i.id));
    return q.trim() ? searchItems(pool, q) : pool;
  }, [items, exclude, q]);
  return (
    <Sheet open title={title} onClose={onClose}>
      <input type="search" autoFocus value={q} onChange={(e) => setQ(e.target.value)} placeholder="Search dishes…" aria-label="Search dishes" className="mb-3 h-12 w-full rounded-full border border-cream-300 bg-cream-50 px-4 text-base outline-none focus:border-leaf-500" />
      <ul className="space-y-2">
        {options.map((i) => (
          <li key={i.id}>
            <button type="button" onClick={() => onPick(i.id)} className="flex w-full items-center gap-3 rounded-2xl border border-cream-300 bg-cream-100 p-2 text-left hover:bg-cream-200">
              <div className="h-12 w-14 flex-shrink-0 overflow-hidden rounded-xl surface-sage-tile"><FoodImage src={i.image} alt="" variant={i.imageStyle} className={`h-full w-full ${i.imageStyle === "cutout" ? "p-1" : ""}`} /></div>
              <span className="min-w-0"><span className="block truncate text-sm font-bold">{i.name}</span><span className="text-xs text-ink-500">{i.category} · {formatPrice(i.price)}</span></span>
            </button>
          </li>
        ))}
        {options.length === 0 && <li className="py-6 text-center text-sm text-ink-500">No dishes to add.</li>}
      </ul>
    </Sheet>
  );
}

function Row({ item, onUp, onDown, onRemove, first, last }) {
  return (
    <li className="flex items-center gap-2 rounded-2xl border border-cream-300 bg-cream-100 p-2">
      <div className="h-12 w-14 flex-shrink-0 overflow-hidden rounded-xl surface-sage-tile"><FoodImage src={item.image} alt="" variant={item.imageStyle} className={`h-full w-full ${item.imageStyle === "cutout" ? "p-1" : ""}`} /></div>
      <span className="min-w-0 flex-1 truncate text-sm font-bold">{item.name}</span>
      {[[onUp, ArrowUp, "Move up", first], [onDown, ArrowDown, "Move down", last]].map(([fn, Icon, label, off]) => (
        <button key={label} type="button" onClick={fn} disabled={off} aria-label={`${label}: ${item.name}`} className="flex h-10 w-10 items-center justify-center rounded-full hover:bg-cream-200 disabled:opacity-25"><Icon size={16} /></button>
      ))}
      <button type="button" onClick={onRemove} aria-label={`Remove ${item.name}`} className="flex h-10 w-10 items-center justify-center rounded-full text-red-600 hover:bg-red-50"><Trash2 size={16} /></button>
    </li>
  );
}

/** Home-screen tab: choose what appears in the hero carousel and the two sub-hero cards, with a live preview. */
export default function LayoutManager({ draft, setDraft }) {
  const [picker, setPicker] = useState(null); // "hero" | 0 | 1
  const model = useMemo(() => buildMenuModel({ items: draft.items, categories: draft.categories, heroIds: draft.layout.heroIds, subheroIds: draft.layout.subheroIds, settings: draft.settings }), [draft]);
  const byId = model.byId;
  const { heroIds, subheroIds } = draft.layout;

  const setLayout = (patch) => setDraft((d) => ({ ...d, layout: { ...d.layout, ...patch } }));
  const move = (ids, i, dir) => {
    const next = [...ids];
    [next[i], next[i + dir]] = [next[i + dir], next[i]];
    return next;
  };

  const pick = (id) => {
    if (picker === "hero") setLayout({ heroIds: [...heroIds, id] });
    else {
      const next = [...subheroIds];
      next[picker] = id;
      setLayout({ subheroIds: next.filter((x) => x != null) });
    }
    setPicker(null);
  };

  return (
    <div className="space-y-5 pb-28">
      <Card className="!p-0 overflow-hidden">
        <p className="px-4 pt-3 text-[11px] font-bold uppercase tracking-[0.25em] text-ink-500">Live preview</p>
        <div className="mx-auto max-w-md bg-cream-100 pb-4" aria-hidden="false">
          <HeroCarousel items={model.hero} iconByCategory={model.iconByCategory} onOpenProduct={noop} />
          <SubHero items={model.subhero} iconByCategory={model.iconByCategory} onOpenProduct={noop} />
        </div>
      </Card>

      <Card>
        <div className="mb-3 flex items-baseline justify-between">
          <h2 className="font-display text-base font-extrabold text-leaf-800">Hero carousel</h2>
          <span className="text-xs text-ink-500">{heroIds.length}/{LIMITS.maxHero} slides</span>
        </div>
        <ul className="space-y-2">
          {heroIds.map((id, i) => byId[id] && (
            <Row key={id} item={byId[id]} first={i === 0} last={i === heroIds.length - 1} onUp={() => setLayout({ heroIds: move(heroIds, i, -1) })} onDown={() => setLayout({ heroIds: move(heroIds, i, 1) })} onRemove={() => setLayout({ heroIds: heroIds.filter((x) => x !== id) })} />
          ))}
        </ul>
        {heroIds.length === 0 && <p className="py-3 text-center text-xs text-ink-500">The carousel is hidden until you add a slide.</p>}
        <button type="button" disabled={heroIds.length >= LIMITS.maxHero} onClick={() => setPicker("hero")} className={`${btnGhost} mt-3 w-full`}><Plus size={16} /> Add slide</button>
      </Card>

      <Card>
        <h2 className="mb-3 font-display text-base font-extrabold text-leaf-800">Two feature cards</h2>
        <div className="grid grid-cols-2 gap-3">
          {[0, 1].map((slot) => {
            const item = byId[subheroIds[slot]];
            return (
              <div key={slot} className="rounded-2xl border border-cream-300 bg-cream-100 p-2.5">
                <p className="mb-1.5 text-[10px] font-bold uppercase tracking-widest text-ink-500">{slot === 0 ? "Left (apricot)" : "Right (sage)"}</p>
                {item ? (
                  <div className="mb-2 flex items-center gap-2">
                    <div className="h-10 w-12 flex-shrink-0 overflow-hidden rounded-lg surface-sage-tile"><FoodImage src={item.image} alt="" variant={item.imageStyle} className="h-full w-full" /></div>
                    <span className="line-clamp-2 text-xs font-bold leading-tight">{item.name}</span>
                  </div>
                ) : <p className="mb-2 py-2 text-xs text-ink-500">Empty</p>}
                <div className="flex gap-1.5">
                  <button type="button" onClick={() => setPicker(slot)} className="flex-1 rounded-full bg-cream-50 py-2 text-xs font-bold ring-1 ring-cream-400">{item ? "Change" : "Choose"}</button>
                  {item && <button type="button" onClick={() => setLayout({ subheroIds: subheroIds.filter((_, i) => i !== slot) })} aria-label="Remove" className="flex h-8 w-8 items-center justify-center rounded-full text-red-600 ring-1 ring-red-200"><Trash2 size={13} /></button>}
                </div>
              </div>
            );
          })}
        </div>
      </Card>

      {picker !== null && <Picker title={picker === "hero" ? "Add hero slide" : "Choose a dish"} items={draft.items} exclude={picker === "hero" ? heroIds : []} onPick={pick} onClose={() => setPicker(null)} />}
    </div>
  );
}
</file>

<file path="src/components/merchant/MenuManager.jsx">
import { useMemo, useState } from "react";
import { ImageOff, Plus, Search, Tags } from "lucide-react";
import FoodImage from "../ui/FoodImage.jsx";
import { Switch, btnGhost } from "./ui.jsx";
import ItemEditor from "./ItemEditor.jsx";
import CategoryManager from "./CategoryManager.jsx";
import { searchItems } from "../../lib/search.js";
import { formatPrice } from "../../lib/format.js";
import { nextItemId } from "../../lib/menuDoc.js";

const blank = (category) => ({ id: 0, category, name: "", price: 0, description: "", image: "", imageStyle: "cutout", featured: false, isActive: true, isAvailable: true });

/** Menu tab: find a dish, flip "in stock", edit, add, delete, manage categories. Edits go to the draft; Publish makes them live. */
export default function MenuManager({ draft, setDraft }) {
  const [query, setQuery] = useState("");
  const [filter, setFilter] = useState("All");
  const [editing, setEditing] = useState(null);
  const [showCategories, setShowCategories] = useState(false);

  const iconOf = useMemo(() => Object.fromEntries(draft.categories.map((c) => [c.name, c.icon])), [draft.categories]);
  const list = useMemo(() => {
    const base = query.trim() ? searchItems(draft.items, query) : draft.items;
    return filter === "All" ? base : base.filter((i) => i.category === filter);
  }, [draft.items, query, filter]);

  const patchItem = (id, patch) => setDraft((d) => ({ ...d, items: d.items.map((i) => (i.id === id ? { ...i, ...patch } : i)) }));

  const saveItem = (item) => {
    setDraft((d) => {
      const exists = d.items.some((i) => i.id === item.id && item.id);
      return { ...d, items: exists ? d.items.map((i) => (i.id === item.id ? item : i)) : [...d.items, { ...item, id: nextItemId(d.items) }] };
    });
    setEditing(null);
  };

  const deleteItem = (id) => {
    setDraft((d) => ({
      ...d,
      items: d.items.filter((i) => i.id !== id),
      layout: { heroIds: d.layout.heroIds.filter((x) => x !== id), subheroIds: d.layout.subheroIds.filter((x) => x !== id) },
    }));
    setEditing(null);
  };

  const saveCategories = (categories, renames) => {
    setDraft((d) => ({ ...d, categories, items: d.items.map((i) => ({ ...i, category: renames[i.category] ?? i.category })) }));
    if (filter !== "All" && renames[filter]) setFilter(renames[filter]);
    setShowCategories(false);
  };

  return (
    <div>
      <div className="relative">
        <Search size={18} className="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-ink-400" aria-hidden="true" />
        <input type="search" value={query} onChange={(e) => setQuery(e.target.value)} placeholder={`Search ${draft.items.length} dishes…`} aria-label="Search dishes" className="h-12 w-full rounded-full border border-cream-300 bg-cream-50 pl-10 pr-4 text-base outline-none focus:border-leaf-500 focus:ring-2 focus:ring-leaf-200" />
      </div>

      <div className="scrollbar-hide -mx-4 mt-3 flex gap-2 overflow-x-auto px-4">
        {["All", ...draft.categories.map((c) => c.name)].map((name) => (
          <button key={name} type="button" aria-pressed={filter === name} onClick={() => setFilter(name)} className={`flex-shrink-0 rounded-full px-3.5 py-2 text-xs font-bold ring-1 ${filter === name ? "bg-leaf-700 text-white ring-leaf-700" : "bg-cream-50 text-ink-700 ring-cream-300"}`}>
            {name}{name !== "All" && <span className="ml-1 opacity-60">{draft.items.filter((i) => i.category === name).length}</span>}
          </button>
        ))}
        <button type="button" onClick={() => setShowCategories(true)} className="inline-flex flex-shrink-0 items-center gap-1 rounded-full px-3 py-2 text-xs font-bold text-leaf-700 ring-1 ring-leaf-300"><Tags size={14} /> Edit</button>
      </div>

      <ul className="mt-4 space-y-2.5 pb-28">
        {list.map((item) => (
          <li key={item.id} className="flex items-center gap-3 rounded-2xl border border-cream-300 bg-cream-50 p-2.5">
            <button type="button" onClick={() => setEditing(item)} className="flex min-w-0 flex-1 items-center gap-3 text-left" aria-label={`Edit ${item.name}`}>
              <div className="h-14 w-16 flex-shrink-0 overflow-hidden rounded-xl surface-sage-tile">
                <FoodImage src={item.image} alt="" variant={item.imageStyle} icon={iconOf[item.category]} className={`h-full w-full ${item.imageStyle === "cutout" ? "p-1" : ""}`} />
              </div>
              <div className="min-w-0">
                <p className="truncate text-sm font-bold">{item.name}</p>
                <p className="truncate text-xs text-ink-500">{item.category} · <span className="font-semibold text-leaf-700">{formatPrice(item.price)}</span></p>
                <div className="mt-0.5 flex flex-wrap gap-1">
                  {!item.isActive && <span className="rounded bg-ink-200 px-1.5 py-px text-[10px] font-bold text-ink-700">Hidden</span>}
                  {item.image === "menu/placeholder.svg" && <span className="inline-flex items-center gap-0.5 rounded bg-apricot-300 px-1.5 py-px text-[10px] font-bold text-sun-900"><ImageOff size={10} />No photo</span>}
                </div>
              </div>
            </button>
            <div className="flex flex-shrink-0 flex-col items-center gap-0.5">
              <Switch checked={item.isAvailable} onChange={(v) => patchItem(item.id, { isAvailable: v })} label={`${item.name} in stock`} />
              <span className="text-[10px] font-semibold text-ink-500">{item.isAvailable ? "In stock" : "Sold out"}</span>
            </div>
          </li>
        ))}
        {list.length === 0 && <li className="py-10 text-center text-sm text-ink-500">No dishes found.</li>}
      </ul>

      <div className="pointer-events-none fixed inset-x-0 bottom-[calc(4.75rem+env(safe-area-inset-bottom))] z-20">
        <div className="mx-auto flex max-w-2xl justify-end px-4">
          <button type="button" onClick={() => setEditing(blank(filter !== "All" ? filter : draft.categories[0]?.name ?? ""))} className={`${btnGhost} pointer-events-auto !border-0 !bg-sun-500 !text-leaf-950 shadow-fab`}><Plus size={18} strokeWidth={2.5} /> Add dish</button>
        </div>
      </div>

      {editing && <ItemEditor item={editing} categories={draft.categories} onSave={saveItem} onDelete={deleteItem} onClose={() => setEditing(null)} />}
      {showCategories && <CategoryManager categories={draft.categories} items={draft.items} onChange={saveCategories} onClose={() => setShowCategories(false)} />}
    </div>
  );
}
</file>

<file path="src/components/merchant/MerchantLogin.jsx">
import { useState } from "react";
import { Eye, EyeOff, Lock } from "lucide-react";
import { SITE, assetUrl } from "../../config/site.js";
import { api } from "../../services/api.js";
import { Field } from "../ui/FormField.jsx";
import { inputClass } from "../ui/formStyles.js";
import { btnPrimary } from "./ui.jsx";

/** Password lock. The browser sends the password to the server over HTTPS; the server checks it against the hash in private storage. */
export default function MerchantLogin({ onUnlocked, demo = false }) {
  const [password, setPassword] = useState("");
  const [show, setShow] = useState(false);
  const [busy, setBusy] = useState(false);
  const [error, setError] = useState("");

  const submit = async (e) => {
    e.preventDefault();
    setBusy(true);
    setError("");
    try {
      onUnlocked(await api.merchant.login(password));
    } catch (err) {
      setError(err.status === 429 ? `Too many attempts. Try again in ${Math.ceil((err.data?.retryAfter ?? 600) / 60)} min.` : err.message);
      setBusy(false);
    }
  };

  return (
    <div className="flex min-h-svh items-center justify-center bg-sage-300 bg-[radial-gradient(120%_80%_at_20%_0%,rgba(255,255,255,0.55),transparent_60%)] px-4">
      <form onSubmit={submit} className="w-full max-w-sm rounded-3xl bg-cream-50 p-7 shadow-card" noValidate>
        <img src={assetUrl(SITE.logoPath)} alt="" className="mx-auto h-20 w-20 rounded-full border border-cream-300 object-cover" />
        <h1 className="mt-4 text-center font-display text-xl font-extrabold text-leaf-800">Kitchen Console</h1>
        <p className="mt-1 text-center text-xs text-ink-500">Jay&apos;s Bistro · merchant portal</p>

        <div className="mt-6">
          <Field id="pw" label="Password" error={error}>
            <div className="relative">
              <input id="pw" type={show ? "text" : "password"} autoFocus autoComplete="current-password" value={password} onChange={(e) => setPassword(e.target.value)} className={`${inputClass(error)} pr-12`} />
              <button type="button" onClick={() => setShow((s) => !s)} aria-label={show ? "Hide password" : "Show password"} className="absolute right-1.5 top-1/2 flex h-9 w-9 -translate-y-1/2 items-center justify-center rounded-full text-ink-500 hover:bg-cream-200">
                {show ? <EyeOff size={18} /> : <Eye size={18} />}
              </button>
            </div>
          </Field>
        </div>
        {demo && (
          <p className="mt-3 rounded-xl bg-apricot-200 px-3 py-2 text-xs font-semibold text-sun-900">
            Demo mode: nothing is connected yet. Use the setup password <code className="rounded bg-white/60 px-1.5 py-0.5 font-mono">jays-setup</code>.
          </p>
        )}
        <button type="submit" disabled={busy || !password} className={`${btnPrimary} mt-5 w-full`}><Lock size={16} /> {busy ? "Checking…" : "Unlock"}</button>
        <p className="mt-4 text-center text-[11px] text-ink-500">This page is private and isn&apos;t listed on the website.</p>
      </form>
    </div>
  );
}
</file>

<file path="src/components/merchant/OrdersPanel.jsx">
import { useEffect, useMemo, useState } from "react";
import { Bike, ChevronDown, Store } from "lucide-react";
import { Badge } from "./fields.jsx";
import { Card } from "./ui.jsx";
import WhatsAppIcon from "../icons/WhatsAppIcon.jsx";
import { api } from "../../services/api.js";
import { breakdowns } from "../../lib/orderStats.js";
import { nextAction, STATUS_LABEL, STATUSES } from "../../lib/orderStatus.js";
import { formatPrice } from "../../lib/format.js";
import { channelLabel, formatLagosDateTime, isTestMode } from "../../lib/receipt.js";

const RANGES = [[1, "Today"], [7, "7 days"], [30, "30 days"]];
const STATUS_TONE = { new: "warn", preparing: "demo", ready: "good", completed: "neutral" };

export function Kpi({ label, value }) {
  return (
    <div className="surface-sage rounded-2xl p-3 text-leaf-950">
      <p className="text-[10px] font-bold uppercase tracking-widest text-leaf-800">{label}</p>
      <p className="mt-1 font-display text-lg font-black leading-none tabular-nums">{value}</p>
    </div>
  );
}

/** 24 bars (Lagos hours), labelled every 6 h, the busiest hour highlighted. */
export function HourBars({ hours }) {
  const max = Math.max(1, ...hours.map((h) => h.orders));
  const peak = hours.reduce((best, h) => (h.orders > best.orders ? h : best), hours[0]);
  return (
    <div>
      <div className="flex h-24 items-end gap-0.5" role="img" aria-label={`Orders by hour of day. Busiest hour: ${peak.orders ? `${peak.hour}:00` : "none yet"}`}>
        {hours.map((h) => (
          <div key={h.hour} className="flex flex-1 flex-col justify-end" title={`${String(h.hour).padStart(2, "0")}:00 · ${h.orders} orders`}>
            <div className={`w-full rounded-t ${h.hour === peak.hour && h.orders ? "bg-sun-500" : "bg-sage-500"}`} style={{ height: `${h.orders ? Math.max(8, (h.orders / max) * 100) : 3}%`, opacity: h.orders ? 1 : 0.35 }} />
          </div>
        ))}
      </div>
      <div className="mt-1 flex justify-between text-[10px] text-ink-500"><span>12am</span><span>6am</span><span>12pm</span><span>6pm</span><span>11pm</span></div>
    </div>
  );
}

function SplitBar({ parts }) {
  const total = parts.reduce((s, p) => s + p.value, 0) || 1;
  return (
    <div>
      <div className="flex h-3 overflow-hidden rounded-full bg-cream-200">
        {parts.map((p) => <div key={p.label} className={p.color} style={{ width: `${(p.value / total) * 100}%` }} />)}
      </div>
      <div className="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-xs text-ink-600">
        {parts.map((p) => <span key={p.label} className="inline-flex items-center gap-1.5"><span className={`h-2 w-2 rounded-full ${p.color}`} />{p.label} <b className="tabular-nums">{p.value}</b></span>)}
      </div>
    </div>
  );
}

export function OrderRow({ order, canTrack, onAdvance, busy }) {
  const [open, setOpen] = useState(false);
  const when = formatLagosDateTime(order.payment.paidAt);
  const delivery = order.fulfilment === "delivery";
  const Icon = delivery ? Bike : Store;
  const status = order.fulfilmentStatus ?? "new";
  const action = canTrack ? nextAction(status, order.fulfilment) : null;

  return (
    <li className="rounded-2xl border border-cream-300 bg-cream-50">
      <button type="button" onClick={() => setOpen((o) => !o)} aria-expanded={open} className="flex w-full items-center gap-3 p-3 text-left">
        <span className="surface-apricot flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-full text-sun-900"><Icon size={16} /></span>
        <span className="min-w-0 flex-1">
          <span className="block truncate text-sm font-bold">{order.customer.name} <span className="font-mono text-[11px] font-semibold text-ink-500">{order.code}</span></span>
          <span className="text-xs text-ink-500">{when.date} · {when.time} · {delivery ? order.zone?.name ?? "Delivery" : "Pickup"}</span>
        </span>
        <span className="flex flex-col items-end gap-1">
          <span className="text-sm font-extrabold tabular-nums text-leaf-700">{formatPrice(order.total)}</span>
          {canTrack && <Badge tone={STATUS_TONE[status]}>{STATUS_LABEL[status]}</Badge>}
        </span>
        <ChevronDown size={16} className={`text-ink-400 transition ${open ? "rotate-180" : ""}`} />
      </button>

      {open && (
        <div className="space-y-2 border-t border-dashed border-cream-400 p-3 text-xs">
          <ul className="space-y-1">{order.items.map((it) => <li key={it.id} className="flex justify-between"><span>{it.quantity}× {it.name}</span><span className="tabular-nums">{formatPrice(it.lineTotal)}</span></li>)}</ul>
          {order.deliveryFee > 0 && <p className="flex justify-between text-ink-600"><span>Delivery</span><span>{formatPrice(order.deliveryFee)}</span></p>}
          {order.serviceFee > 0 && <p className="flex justify-between text-ink-600"><span>Online payment fee</span><span>{formatPrice(order.serviceFee)}</span></p>}
          {delivery && <p><span className="font-bold">Address:</span> {order.customer.address}</p>}
          {order.customer.note && <p><span className="font-bold">Note:</span> {order.customer.note}</p>}
          <p className="text-ink-500">Paid via {channelLabel(order.payment.channel)} · {order.payment.reference}{isTestMode(order.payment.mode) ? ` (${order.payment.mode})` : ""}</p>
          {order.alert && <p className="text-ink-500">Kitchen alert: <b>{order.alert.status}</b> ({order.alert.channel})</p>}
          <div className="flex flex-wrap gap-2 pt-1">
            {action && <button type="button" disabled={busy} onClick={() => onAdvance(order.id, action.to)} className="rounded-full bg-leaf-700 px-4 py-2 font-bold text-white disabled:opacity-50">{action.label}</button>}
            <a href={`tel:+${order.customer.phone}`} className="rounded-full bg-cream-200 px-3 py-2 font-bold">Call +{order.customer.phone}</a>
            <a href={`https://wa.me/${order.customer.phone}?text=${encodeURIComponent(`Hi ${order.customer.name.split(" ")[0]}, this is Jay's Bistro about your order ${order.code}.`)}`} target="_blank" rel="noopener noreferrer" className="inline-flex items-center gap-1 rounded-full bg-[#25D366] px-3 py-2 font-bold text-white"><WhatsAppIcon size={14} /> WhatsApp</a>
          </div>
        </div>
      )}
    </li>
  );
}

/** Orders + sales analytics. `canTrack` shows the kitchen workflow (demo now; real endpoint arrives with the integration). */
export default function OrdersPanel({ canTrack, initialDays = 7 }) {
  const [days, setDays] = useState(initialDays);
  const [includeTest, setIncludeTest] = useState(false);
  const [filter, setFilter] = useState("all");
  const [state, setState] = useState({ loading: true });
  const [busyId, setBusyId] = useState(null);

  useEffect(() => {
    let cancelled = false;
    api.merchant.orders(days, includeTest).then((data) => !cancelled && setState({ data })).catch((e) => !cancelled && setState({ error: e.message }));
    return () => { cancelled = true; };
  }, [days, includeTest]);

  const { data, error } = state;
  const orders = useMemo(() => data?.orders ?? [], [data]);
  const stats = useMemo(() => breakdowns(orders), [orders]);
  const counts = useMemo(() => Object.fromEntries(STATUSES.map((s) => [s, orders.filter((o) => (o.fulfilmentStatus ?? "new") === s).length])), [orders]);
  const shown = filter === "all" ? orders : orders.filter((o) => (o.fulfilmentStatus ?? "new") === filter);
  const maxRevenue = Math.max(1, ...(data?.daily.map((d) => d.revenue) ?? [1]));

  const advance = async (id, status) => {
    setBusyId(id);
    try {
      const updated = await api.merchant.setOrderStatus(id, status);
      setState((s) => ({ ...s, data: { ...s.data, orders: s.data.orders.map((o) => (o.id === id ? updated : o)) } }));
    } catch (e) {
      setState((s) => ({ ...s, error: e.message }));
    } finally {
      setBusyId(null);
    }
  };

  return (
    <div className="space-y-4 pb-28">
      <div role="group" aria-label="Date range" className="grid grid-cols-3 rounded-full bg-cream-200 p-0.5 text-xs font-bold">
        {RANGES.map(([d, label]) => (
          <button key={d} type="button" aria-pressed={days === d} onClick={() => { setState({ loading: true }); setDays(d); }} className={`rounded-full py-2.5 ${days === d ? "bg-leaf-700 text-white" : "text-ink-600"}`}>{label}</button>
        ))}
      </div>

      {error && <p role="alert" className="rounded-xl bg-red-50 p-3 text-sm font-semibold text-red-700">{error}</p>}
      {state.loading && <div className="space-y-3" role="status" aria-label="Loading orders"><div className="skeleton h-20 rounded-2xl" /><div className="skeleton h-40 rounded-2xl" /></div>}

      {data && (
        <>
          <div className="grid grid-cols-3 gap-2">
            <Kpi label="Sales" value={formatPrice(data.kpis.revenue)} />
            <Kpi label="Orders" value={data.kpis.orders} />
            <Kpi label="Avg order" value={formatPrice(data.kpis.averageOrder)} />
          </div>

          {data.testOrders > 0 && (
            <label className="flex items-center justify-between gap-3 rounded-xl bg-apricot-200 px-3 py-2 text-xs font-semibold text-sun-900">
              <span>{data.testOrders} test payment{data.testOrders === 1 ? "" : "s"} hidden from sales</span>
              <input type="checkbox" checked={includeTest} onChange={(e) => { setState({ loading: true }); setIncludeTest(e.target.checked); }} className="h-4 w-4 accent-leaf-700" aria-label="Include test payments" />
            </label>
          )}

          {data.kpis.orders === 0 ? (
            <Card className="py-10 text-center"><p className="font-bold">No paid orders yet</p><p className="mt-1 text-xs text-ink-500">Paid orders appear here the moment payment is confirmed.</p></Card>
          ) : (
            <>
              {days > 1 && (
                <Card>
                  <h2 className="mb-3 text-xs font-bold uppercase tracking-widest text-ink-500">Sales per day</h2>
                  <div className="flex h-28 items-end gap-1" role="img" aria-label="Bar chart of daily sales">
                    {data.daily.map((d) => (
