    expect(pickActiveGroup(groups(300, 1500, 2400), 200)).toBe("Meals");
  });

  it("switches when the next group's first card rises above the line", () => {
    expect(pickActiveGroup(groups(-900, 150, 900), 200)).toBe("Protein");
