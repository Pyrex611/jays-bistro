  try {
    const raw = JSON.parse(localStorage.getItem(KEY) ?? "[]");
    return Array.isArray(raw)
      ? raw.filter((l) => Number.isInteger(l?.id) && Number.isInteger(l?.quantity) && l.quantity > 0 && l.quantity <= 20).slice(0, 60)
      : [];
  } catch {
