}

export const SwitchRow = ({ title, hint, checked, onChange, disabled }) => (
  <div className="flex items-center justify-between gap-3 py-3">
    <div className="min-w-0">
      <p className="text-sm font-bold">{title}</p>
      {hint && <p className="text-[11px] text-ink-500">{hint}</p>}
    </div>
    <Switch checked={checked} onChange={onChange} label={title} disabled={disabled} />
  </div>
);

export const Row = ({ title, hint, children }) => (
  <div className="flex items-center justify-between gap-3 py-3">
    <div className="min-w-0">
      <p className="text-sm font-bold">{title}</p>
      {hint && <p className="text-[11px] text-ink-500">{hint}</p>}
    </div>
    {children}
  </div>
);

/** Whole-number input with a prefix/suffix. Keeps digits only. */
export function NumberBox({ id, value, onChange, prefix, suffix, width = "w-28", label, step }) {
  return (
    <div className={`relative ${width} flex-shrink-0`}>
      {prefix && <span className="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-sm text-ink-500">{prefix}</span>}
      <input
        id={id}
        aria-label={label}
        inputMode={step ? "decimal" : "numeric"}
        value={value}
        onChange={(e) => {
          const raw = step ? e.target.value.replace(/[^\d.]/g, "") : e.target.value.replace(/\D/g, "");
          onChange(raw === "" ? 0 : Number(raw));
        }}
        className={`h-11 w-full rounded-xl border border-cream-300 bg-cream-50 text-right text-base outline-none focus:border-leaf-500 focus:ring-2 focus:ring-leaf-200 ${prefix ? "pl-7" : "pl-3"} ${suffix ? "pr-8" : "pr-3"}`}
      />
      {suffix && <span className="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-sm text-ink-500">{suffix}</span>}
    </div>
  );
}

/** Small status pill used across the console. */
export function Badge({ tone = "neutral", children }) {
  const tones = {
    neutral: "bg-cream-300 text-ink-700",
    good: "bg-sage-200 text-leaf-900",
    warn: "bg-apricot-300 text-sun-900",
    demo: "bg-apricot-200 text-sun-900 ring-1 ring-apricot-400",
    bad: "bg-red-100 text-red-700",
    soon: "bg-cream-200 text-ink-500 ring-1 ring-cream-400",
  };
  return <span className={`inline-flex flex-shrink-0 items-center rounded-full px-2.5 py-1 text-[11px] font-bold ${tones[tone]}`}>{children}</span>;
}
</file>

<file path="src/components/merchant/OverviewPanel.jsx">
import { useEffect, useMemo, useState } from "react";
import { ArrowRight, ExternalLink, LayoutTemplate, PlusCircle, Power } from "lucide-react";
import { Badge } from "./fields.jsx";
import { Card } from "./ui.jsx";
import CategoryIcon from "../icons/CategoryIcon.jsx";
import { api } from "../../services/api.js";
import { getOpenStatus } from "../../lib/hours.js";
import { formatPrice } from "../../lib/format.js";
import { formatLagosDateTime } from "../../lib/receipt.js";
import { nextAction, STATUS_LABEL } from "../../lib/orderStatus.js";
import { integrationStatus } from "../../lib/integrations.js";

const greeting = (now) => {
  const h = Number(new Intl.DateTimeFormat("en-GB", { timeZone: "Africa/Lagos", hour: "2-digit", hour12: false }).format(now)) % 24;
  return h < 12 ? "Good morning" : h < 17 ? "Good afternoon" : "Good evening";
};

/** The first thing the owner sees: how today is going, what needs doing, and what's still to connect. */
export default function OverviewPanel({ draft, saved, capabilities, demo, canTrack, onNavigate, onToggleOrders }) {
  const [state, setState] = useState({ loading: true });
  const now = useMemo(() => new Date(), []);
  const settings = saved.settings;
  const status = getOpenStatus(settings.hours, now, settings.closures);

  useEffect(() => {
    let cancelled = false;
    Promise.all([api.merchant.orders(1), api.merchant.orders(7)])
      .then(([today, week]) => !cancelled && setState({ today, week }))
      .catch((e) => !cancelled && setState({ error: e.message }));
    return () => { cancelled = true; };
  }, []);

  const [busyId, setBusyId] = useState(null);
  const advance = async (id, to) => {
    setBusyId(id);
    try {
      const updated = await api.merchant.setOrderStatus(id, to);
      setState((s) => ({ ...s, week: { ...s.week, orders: s.week.orders.map((o) => (o.id === id ? updated : o)) } }));
    } finally {
      setBusyId(null);
    }
  };

  const open = (state.week?.orders ?? []).filter((o) => (o.fulfilmentStatus ?? "completed") !== "completed").slice(0, 4);
  const soldOut = draft.items.filter((i) => i.isActive && !i.isAvailable);
  const integrations = integrationStatus(capabilities, demo);
  const connected = integrations.filter((i) => i.state === "connected").length;

  return (
    <div className="space-y-4 pb-28">
      <div className="surface-sage rounded-3xl p-5 text-leaf-950">
        <p className="text-xs font-bold uppercase tracking-[0.25em] text-leaf-800">{greeting(now)}</p>
        <h1 className="font-display text-2xl font-black">Jay&apos;s Kitchen</h1>
        <div className="mt-3 flex flex-wrap items-center gap-2">
          <Badge tone={status.open ? "good" : "neutral"}>{status.label}</Badge>
          <Badge tone={settings.acceptingOrders ? "good" : "warn"}>{settings.acceptingOrders ? "Taking orders" : "Orders paused"}</Badge>
        </div>
        <button type="button" onClick={() => onToggleOrders(!settings.acceptingOrders)} className="mt-4 inline-flex items-center gap-2 rounded-full bg-cream-50 px-4 py-2.5 text-xs font-bold text-leaf-900 shadow-sm ring-1 ring-cream-300 transition hover:bg-white">
          <Power size={14} /> {settings.acceptingOrders ? "Pause orders" : "Resume orders"}
        </button>
      </div>

      {state.error && <p role="alert" className="rounded-xl bg-red-50 p-3 text-sm font-semibold text-red-700">{state.error}</p>}
      {state.loading && <div className="skeleton h-24 rounded-2xl" role="status" aria-label="Loading today" />}

      {state.today && (
        <div className="grid grid-cols-3 gap-2">
          {[["Today's sales", formatPrice(state.today.kpis.revenue)], ["Orders today", state.today.kpis.orders], ["Avg order", formatPrice(state.today.kpis.averageOrder)]].map(([label, value]) => (
            <div key={label} className="rounded-2xl border border-cream-300 bg-cream-50 p-3 shadow-sm">
              <p className="text-[10px] font-bold uppercase tracking-widest text-ink-500">{label}</p>
              <p className="mt-1 font-display text-lg font-black leading-none tabular-nums text-leaf-800">{value}</p>
            </div>
          ))}
        </div>
      )}

      <Card>
        <div className="mb-3 flex items-center justify-between">
          <h2 className="font-display text-base font-extrabold text-leaf-800">Needs attention</h2>
          <button type="button" onClick={() => onNavigate("orders")} className="inline-flex items-center gap-1 text-xs font-bold text-leaf-700">All orders <ArrowRight size={13} /></button>
        </div>
        {open.length === 0 ? (
          <p className="py-3 text-center text-sm text-ink-500">{canTrack ? "All caught up. Nothing waiting in the kitchen." : "Order tracking comes with the integration."}</p>
        ) : (
          <ul className="space-y-2">
            {open.map((o) => {
              const action = canTrack ? nextAction(o.fulfilmentStatus ?? "new", o.fulfilment) : null;
              return (
                <li key={o.id} className="flex items-center gap-3 rounded-xl border border-cream-300 bg-cream-100 p-2.5">
                  <div className="min-w-0 flex-1">
                    <p className="truncate text-sm font-bold">{o.customer.name} <span className="font-mono text-[11px] text-ink-500">{o.code}</span></p>
                    <p className="truncate text-xs text-ink-500">{o.items.map((i) => `${i.quantity}× ${i.name}`).join(", ")}</p>
                    <p className="text-[11px] text-ink-400">{formatLagosDateTime(o.payment.paidAt).time} · {STATUS_LABEL[o.fulfilmentStatus ?? "new"]}</p>
                  </div>
                  {action && <button type="button" disabled={busyId === o.id} onClick={() => advance(o.id, action.to)} className="flex-shrink-0 rounded-full bg-leaf-700 px-3 py-2 text-xs font-bold text-white disabled:opacity-50">{action.label}</button>}
                </li>
              );
            })}
          </ul>
        )}
      </Card>

      <Card>
        <h2 className="mb-2 font-display text-base font-extrabold text-leaf-800">Sold out right now</h2>
        {soldOut.length === 0 ? <p className="text-sm text-ink-500">Everything is in stock.</p> : (
          <div className="flex flex-wrap gap-2">
            {soldOut.slice(0, 10).map((i) => <button key={i.id} type="button" onClick={() => onNavigate("menu")} className="rounded-full bg-apricot-200 px-3 py-1.5 text-xs font-bold text-sun-900">{i.name}</button>)}
          </div>
        )}
      </Card>

      <div className="grid grid-cols-2 gap-2">
        {[["menu", PlusCircle, "Add or edit dishes"], ["home", LayoutTemplate, "Edit home screen"]].map(([tab, Icon, label]) => (
          <button key={tab} type="button" onClick={() => onNavigate(tab)} className="flex items-center gap-2 rounded-2xl border border-cream-300 bg-cream-50 p-3 text-left text-sm font-bold shadow-sm transition hover:bg-cream-200"><span className="surface-sage flex h-9 w-9 items-center justify-center rounded-xl text-leaf-800"><Icon size={18} /></span>{label}</button>
        ))}
        <a href="/" target="_blank" rel="noopener noreferrer" className="flex items-center gap-2 rounded-2xl border border-cream-300 bg-cream-50 p-3 text-sm font-bold shadow-sm transition hover:bg-cream-200"><span className="surface-apricot flex h-9 w-9 items-center justify-center rounded-xl text-sun-900"><ExternalLink size={18} /></span>View storefront</a>
        <button type="button" onClick={() => onNavigate("settings", "alerts")} className="flex items-center gap-2 rounded-2xl border border-cream-300 bg-cream-50 p-3 text-left text-sm font-bold shadow-sm transition hover:bg-cream-200"><span className="surface-apricot flex h-9 w-9 items-center justify-center rounded-xl text-sun-900"><CategoryIcon name="all" size={18} /></span>Preview kitchen alert</button>
      </div>

      <Card>
        <div className="mb-3 flex items-center justify-between">
          <h2 className="font-display text-base font-extrabold text-leaf-800">Going live</h2>
          <Badge tone={demo ? "demo" : "good"}>{connected} of {integrations.length} connected</Badge>
        </div>
        <div className="mb-3 h-2 rounded-full bg-cream-200"><div className="h-full rounded-full bg-leaf-600 transition-all" style={{ width: `${(connected / integrations.length) * 100}%` }} /></div>
        <ul className="space-y-1.5 text-sm">
          {integrations.map((i) => (
            <li key={i.key} className="flex items-center justify-between gap-3"><span>{i.name}</span><Badge tone={i.tone}>{i.label}</Badge></li>
          ))}
        </ul>
        <button type="button" onClick={() => onNavigate("settings", "integrations")} className="mt-3 inline-flex items-center gap-1 text-xs font-bold text-leaf-700">See what each one needs <ArrowRight size={13} /></button>
      </Card>
    </div>
  );
}
</file>

<file path="src/components/merchant/settings/AlertsSettings.jsx">
import { useEffect, useState } from "react";
import { BellRing, Mail, MessageSquare, Send, X } from "lucide-react";
import { Badge, Section, SwitchRow } from "../fields.jsx";
import WhatsAppIcon from "../../icons/WhatsAppIcon.jsx";
import { Sheet, btnGhost, btnPrimary } from "../ui.jsx";
import { api } from "../../../services/api.js";
import { formatLagosDateTime } from "../../../lib/receipt.js";

const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
const STATUS_TONE = { simulated: "demo", sent: "good", skipped: "neutral", failed: "bad" };

/** The email exactly as the email channel will send it (rendered by the same pure template). */
function AlertPreview({ result, onClose }) {
  const [tab, setTab] = useState("email");
  return (
    <Sheet open title="Kitchen alert preview" onClose={onClose}>
      <div className="space-y-3 text-sm">
        <p className="rounded-xl bg-apricot-200 px-3 py-2 text-xs font-semibold text-sun-900">Simulated: nothing was sent. This is what the kitchen will receive once email is connected.</p>
        <dl className="grid grid-cols-[auto_1fr] gap-x-3 gap-y-1 text-xs">
          <dt className="text-ink-500">To</dt><dd className="break-all font-semibold">{result.to.length ? result.to.join(", ") : "No recipients yet"}</dd>
          <dt className="text-ink-500">Subject</dt><dd className="font-semibold">{result.rendered.subject}</dd>
        </dl>
        <div role="tablist" aria-label="Preview format" className="grid grid-cols-2 rounded-full bg-cream-200 p-0.5 text-xs font-bold">
          {[["email", "Email"], ["text", "Plain text"]].map(([k, label]) => <button key={k} role="tab" aria-selected={tab === k} type="button" onClick={() => setTab(k)} className={`rounded-full py-2 ${tab === k ? "bg-leaf-700 text-white" : "text-ink-600"}`}>{label}</button>)}
        </div>
        {tab === "email" ? (
          <iframe title="Email preview" sandbox="" srcDoc={`<body style="margin:12px;background:#fff">${result.rendered.html}</body>`} className="h-[26rem] w-full rounded-xl border border-cream-300 bg-white" />
        ) : (
          <pre className="max-h-[26rem] overflow-auto whitespace-pre-wrap rounded-xl border border-cream-300 bg-cream-100 p-3 text-xs">{result.rendered.text}</pre>
        )}
      </div>
    </Sheet>
  );
}

function PlannedChannel({ icon: Icon, name, text }) {
  return (
    <div className="flex items-start justify-between gap-3 rounded-2xl border border-dashed border-cream-400 bg-cream-100 p-3">
      <div className="flex items-start gap-3">
        <span className="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-xl bg-cream-200 text-ink-500"><Icon size={18} /></span>
        <div><p className="text-sm font-bold">{name}</p><p className="text-xs text-ink-500">{text}</p></div>
      </div>
      <Badge tone="soon">Planned</Badge>
    </div>
  );
}

/** Kitchen alerts. Email works as a full simulation today (config, recipients, events, log, preview); real sending arrives with the integration. */
export default function AlertsSettings({ capabilities }) {
  const [state, setState] = useState({ loading: true });
  const [cfg, setCfg] = useState(null);
  const [saved, setSaved] = useState(null);
  const [draftEmail, setDraftEmail] = useState("");
  const [emailError, setEmailError] = useState("");
  const [busy, setBusy] = useState("");
  const [preview, setPreview] = useState(null);
  const [notice, setNotice] = useState("");

  useEffect(() => {
    let cancelled = false;
    api.merchant.getNotifications()
      .then((r) => { if (cancelled) return; setCfg(r.config); setSaved(r.config); setState({ alerts: r.alerts }); })
      .catch((e) => !cancelled && setState({ unavailable: e.status === 501, error: e.message }));
    return () => { cancelled = true; };
  }, []);

  const dirty = cfg && JSON.stringify(cfg) !== JSON.stringify(saved);
  const patch = (p) => setCfg((c) => ({ ...c, ...p }));
  const patchEmail = (p) => setCfg((c) => ({ ...c, email: { ...c.email, ...p } }));
  const patchEvents = (p) => setCfg((c) => ({ ...c, events: { ...c.events, ...p } }));

  const addRecipient = () => {
    const v = draftEmail.trim().toLowerCase();
    if (!EMAIL_RE.test(v)) return setEmailError("That doesn't look like an email address.");
    if (cfg.email.recipients.includes(v)) return setEmailError("Already added.");
    if (cfg.email.recipients.length >= 5) return setEmailError("Up to 5 recipients.");
    patchEmail({ recipients: [...cfg.email.recipients, v] });
    setDraftEmail("");
    setEmailError("");
  };

  const save = async () => {
    setBusy("save");
    try {
      const r = await api.merchant.saveNotifications(cfg);
      setCfg(r.config); setSaved(r.config); setState({ alerts: r.alerts });
      setNotice("Alert settings saved.");
    } catch (e) {
      setNotice(e.message);
    } finally { setBusy(""); }
  };

  const test = async () => {
    setBusy("test");
    try {
      if (dirty) await save();
      const r = await api.merchant.sendTestAlert();
      setPreview(r);
      setState({ alerts: r.alerts });
    } catch (e) {
      setNotice(e.message);
    } finally { setBusy(""); }
  };

  const badge = <Badge tone={capabilities?.email ? "good" : "demo"}>{capabilities?.email ? "Connected" : "Simulated"}</Badge>;

  return (
    <Section id="alerts" icon={BellRing} title="Kitchen alerts" subtitle="Get told the moment an order is paid." badge={badge}>
      {state.loading && <div className="skeleton h-32 rounded-2xl" role="status" aria-label="Loading alerts" />}

      {state.unavailable && (
        <div className="rounded-2xl border border-dashed border-cream-400 bg-cream-100 p-4 text-sm text-ink-600">
          <p className="font-bold text-ink-800">Alerts connect with the integration</p>
          <p className="mt-1 text-xs">Recipients, events, test sends and the alert log are designed and ready. They switch on when email is connected.</p>
        </div>
      )}
      {state.error && !state.unavailable && <p role="alert" className="text-sm font-semibold text-red-600">{state.error}</p>}

      {cfg && (
        <div className="space-y-4">
          <div className="rounded-2xl border border-cream-300 bg-cream-100 p-3">
            <div className="flex items-start gap-3">
              <span className="surface-sage flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-xl text-leaf-800"><Mail size={18} /></span>
              <div className="min-w-0 flex-1">
                <SwitchRow title="Email" hint="Sent to everyone listed below." checked={cfg.email.enabled} onChange={(v) => patchEmail({ enabled: v })} />
              </div>
            </div>

            <ul className="mt-1 flex flex-wrap gap-2">
              {cfg.email.recipients.map((r) => (
                <li key={r} className="inline-flex items-center gap-1 rounded-full bg-sage-200 py-1 pl-3 pr-1 text-xs font-semibold text-leaf-900">{r}
                  <button type="button" aria-label={`Remove ${r}`} onClick={() => patchEmail({ recipients: cfg.email.recipients.filter((x) => x !== r) })} className="flex h-6 w-6 items-center justify-center rounded-full hover:bg-sage-300"><X size={12} /></button>
                </li>
              ))}
              {cfg.email.recipients.length === 0 && <li className="text-xs text-ink-500">No recipients yet.</li>}
            </ul>
            <div className="mt-2 flex gap-2">
              <input type="email" inputMode="email" aria-label="Add a recipient email" value={draftEmail} onChange={(e) => { setDraftEmail(e.target.value); setEmailError(""); }} onKeyDown={(e) => e.key === "Enter" && (e.preventDefault(), addRecipient())} placeholder="kitchen@example.com" className="h-11 flex-1 rounded-xl border border-cream-300 bg-cream-50 px-3 text-base outline-none focus:border-leaf-500 focus:ring-2 focus:ring-leaf-200" />
              <button type="button" onClick={addRecipient} className={`${btnPrimary} !px-4`}>Add</button>
            </div>
            {emailError && <p role="alert" className="mt-1 text-xs font-medium text-red-600">{emailError}</p>}
          </div>

          <div className="divide-y divide-cream-300 rounded-2xl border border-cream-300 bg-cream-100 px-4">
            <SwitchRow title="A paid order comes in" hint="The main one." checked={cfg.events.orderPaid} onChange={(v) => patchEvents({ orderPaid: v })} />
            <SwitchRow title="A WhatsApp invoice is created" hint="Heads-up before payment." checked={cfg.events.invoiceCreated} onChange={(v) => patchEvents({ invoiceCreated: v })} />
            <SwitchRow title="A payment doesn't match" hint="Wrong amount or currency, so it needs a look." checked={cfg.events.paymentMismatch} onChange={(v) => patchEvents({ paymentMismatch: v })} />
            <SwitchRow title="Daily summary at closing time" hint="Planned." checked={false} onChange={() => {}} disabled />
            <SwitchRow title="Also alert for test payments" hint="Off keeps rehearsals from waking the kitchen." checked={cfg.alertOnTest} onChange={(v) => patch({ alertOnTest: v })} />
          </div>

          <div className="flex flex-wrap gap-2">
            <button type="button" onClick={save} disabled={!dirty || busy !== ""} className={btnPrimary}>{busy === "save" ? "Saving…" : "Save alerts"}</button>
            <button type="button" onClick={test} disabled={busy !== ""} className={btnGhost}><Send size={15} /> {busy === "test" ? "Rendering…" : "Send test alert"}</button>
          </div>
          {notice && <p role="status" className="text-xs font-semibold text-leaf-700">{notice}</p>}

          <div className="space-y-2">
            <PlannedChannel icon={WhatsAppIcon} name="WhatsApp alert" text="A message to the kitchen's WhatsApp for every paid order." />
            <PlannedChannel icon={MessageSquare} name="SMS alert" text="A text for kitchens without data." />
          </div>

          <div>
            <h3 className="mb-2 text-xs font-bold uppercase tracking-widest text-ink-500">Recent alerts</h3>
            {(state.alerts ?? []).length === 0 ? <p className="text-sm text-ink-500">Nothing yet. Send a test alert to see one here.</p> : (
              <ul className="space-y-2">
                {state.alerts.slice(0, 8).map((a) => (
                  <li key={a.id} className="rounded-xl border border-cream-300 bg-cream-50 p-2.5">
                    <div className="flex items-center justify-between gap-2"><p className="truncate text-sm font-bold">{a.orderCode} <span className="text-xs font-normal text-ink-500">· {a.type === "test" ? "test" : "paid order"}</span></p><Badge tone={STATUS_TONE[a.status]}>{a.status}</Badge></div>
                    <p className="truncate text-xs text-ink-500">{a.subject}</p>
                    <p className="text-[11px] text-ink-400">{formatLagosDateTime(a.at).full}{a.reason ? ` · ${a.reason}` : ""}</p>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </div>
      )}

      {preview && <AlertPreview result={preview} onClose={() => setPreview(null)} />}
    </Section>
  );
}
</file>

<file path="src/components/merchant/settings/BusinessSettings.jsx">
import { ExternalLink, Store } from "lucide-react";
import { Section, SwitchRow } from "../fields.jsx";
import { Field } from "../../ui/FormField.jsx";
import { inputClass } from "../../ui/formStyles.js";

/** Contact + pickup details and the optional announcement banner. */
export default function BusinessSettings({ settings, set }) {
  const b = settings.business;
  const patch = (p) => set({ business: { ...b, ...p } });
  const digits = b.whatsapp.replace(/\D/g, "");
  const validWa = digits.length >= 10 && digits.length <= 15;

  return (
    <Section id="business" icon={Store} title="Business details" subtitle="Used on the info sheet, receipts and every WhatsApp link.">
      <div className="space-y-4">
        <Field id="b-wa" label="WhatsApp number" error={validWa ? undefined : "Use international format, e.g. 2348062624447"} hint="Digits only, with country code. Orders and “Message us” buttons go here.">
          <div className="flex gap-2">
            <input id="b-wa" inputMode="numeric" className={inputClass(!validWa)} value={b.whatsapp} onChange={(e) => patch({ whatsapp: e.target.value.replace(/\D/g, "").slice(0, 15) })} />
            <a href={`https://wa.me/${digits}`} target="_blank" rel="noopener noreferrer" aria-label="Test this WhatsApp number" className="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-xl bg-[#25D366] text-white"><ExternalLink size={18} /></a>
          </div>
        </Field>
        <Field id="b-phone" label="Phone (for calls)"><input id="b-phone" type="tel" inputMode="tel" className={inputClass(false)} value={b.phone} onChange={(e) => patch({ phone: e.target.value.slice(0, 20) })} placeholder="+234 806 262 4447" /></Field>
        <Field id="b-addr" label="Address"><input id="b-addr" className={inputClass(false)} value={b.address} onChange={(e) => patch({ address: e.target.value.slice(0, 120) })} /></Field>
        <Field id="b-pick" label="Pickup instructions" hint="e.g. “Collect at the side counter”"><input id="b-pick" className={inputClass(false)} value={b.pickupNote} onChange={(e) => patch({ pickupNote: e.target.value.slice(0, 200) })} /></Field>
        <div className="rounded-2xl border border-cream-300 bg-cream-100 px-4">
          <SwitchRow title="Show an announcement banner" hint="Appears at the top of the menu, e.g. “Closed Sunday for Easter”." checked={b.announcementEnabled} onChange={(v) => patch({ announcementEnabled: v })} />
          <div className="pb-4">
            <label htmlFor="b-ann" className="sr-only">Announcement text</label>
            <input id="b-ann" className={inputClass(false)} value={b.announcement} onChange={(e) => patch({ announcement: e.target.value.slice(0, 160) })} placeholder="Your announcement" />
            {b.announcementEnabled && b.announcement && <p className="mt-2 rounded-xl bg-sage-200 px-3 py-2 text-xs font-semibold text-leaf-900">{b.announcement}</p>}
          </div>
        </div>
      </div>
    </Section>
  );
}
</file>

<file path="src/components/merchant/settings/DeliverySettings.jsx">
import { useState } from "react";
import { ArrowDown, ArrowUp, Bike, Pencil, Plus, Trash2 } from "lucide-react";
import { Badge, NumberBox, Row, Section, SwitchRow } from "../fields.jsx";
import { Sheet, btnDanger, btnGhost, btnPrimary } from "../ui.jsx";
import { Field } from "../../ui/FormField.jsx";
import { inputClass } from "../../ui/formStyles.js";
import { DEMO_ZONES } from "../../../demo/demoStore.js";
import { formatPrice } from "../../../lib/format.js";

const BLANK = { id: "", name: "", fee: 500, minOrder: 0, etaMins: [20, 35], enabled: true };
const eta = (r) => (r?.[1] ? `${r[0]}–${r[1]} min` : "no ETA");

function ZoneSheet({ zone, onSave, onDelete, onClose }) {
  const isNew = !zone.name;
  const [form, setForm] = useState(zone);
  const [error, setError] = useState("");
  const [confirm, setConfirm] = useState(false);
  const patch = (p) => setForm((f) => ({ ...f, ...p }));

  const save = () => {
    const name = form.name.trim();
    if (name.length < 2 || name.length > 40) return setError("Give the area a name (2–40 characters).");
    onSave({ ...form, name });
  };

  return (
    <Sheet
      open
      title={isNew ? "Add delivery area" : "Edit delivery area"}
      onClose={onClose}
      footer={
        <div className="flex gap-2">
          {!isNew && <button type="button" className={`${confirm ? btnDanger : btnGhost} !px-4`} onClick={() => (confirm ? onDelete(zone.id) : setConfirm(true))} aria-label="Delete area"><Trash2 size={16} />{confirm ? " Tap to confirm" : ""}</button>}
          <button type="button" className={`${btnPrimary} flex-1`} onClick={save}>{isNew ? "Add area" : "Save area"}</button>
        </div>
      }
    >
      <div className="space-y-4">
        <Field id="z-name" label="Area name" error={error}><input id="z-name" className={inputClass(error)} value={form.name} onChange={(e) => patch({ name: e.target.value })} placeholder="High Level" maxLength={40} /></Field>
        <div className="grid grid-cols-2 gap-3">
          <Field id="z-fee" label="Delivery fee"><NumberBox id="z-fee" width="w-full" prefix="₦" value={form.fee} onChange={(v) => patch({ fee: v })} /></Field>
          <Field id="z-min" label="Minimum order" hint="0 = use the global minimum"><NumberBox id="z-min" width="w-full" prefix="₦" value={form.minOrder} onChange={(v) => patch({ minOrder: v })} /></Field>
        </div>
        <Field id="z-eta" label="Estimated delivery time (minutes)" hint="Leave both at 0 to hide the estimate">
          <div className="flex items-center gap-2">
            <NumberBox label="From" width="w-full" value={form.etaMins[0]} onChange={(v) => patch({ etaMins: [v, Math.max(v, form.etaMins[1])] })} />
            <span className="text-ink-400">to</span>
            <NumberBox label="To" width="w-full" value={form.etaMins[1]} onChange={(v) => patch({ etaMins: [Math.min(form.etaMins[0], v), v] })} />
          </div>
        </Field>
        <SwitchRow title="Delivering here" hint="Off hides the area from customers without deleting it." checked={form.enabled} onChange={(v) => patch({ enabled: v })} />
      </div>
    </Sheet>
  );
}

/** Delivery areas with per-area fee, minimum and ETA; free-delivery threshold; customer-facing note. */
export default function DeliverySettings({ settings, set }) {
  const [editing, setEditing] = useState(null);
  const zones = settings.zones;
  const move = (i, d) => {
    const next = [...zones];
    [next[i], next[i + d]] = [next[i + d], next[i]];
    set({ zones: next });
  };
  const save = (zone) => {
    const exists = zones.some((z) => z.id === zone.id && zone.id);
    set({ zones: exists ? zones.map((z) => (z.id === zone.id ? zone : z)) : [...zones, zone] });
    setEditing(null);
  };

  return (
    <Section id="delivery" icon={Bike} title="Delivery" subtitle="Where you deliver, what it costs, and how long it takes." badge={<Badge tone={settings.deliveryEnabled ? "good" : "neutral"}>{settings.deliveryEnabled ? "On" : "Pickup only"}</Badge>}>
      <SwitchRow title="Offer delivery" hint="Off = customers can only choose pickup." checked={settings.deliveryEnabled} onChange={(v) => set({ deliveryEnabled: v })} />

      <div className="mt-2">
        <div className="mb-2 flex items-center justify-between">
          <h3 className="text-xs font-bold uppercase tracking-widest text-ink-500">Delivery areas</h3>
          <span className="text-xs text-ink-500">{zones.filter((z) => z.enabled).length} active</span>
        </div>
        <ul className="space-y-2">
          {zones.map((z, i) => (
            <li key={z.id} className={`flex items-center gap-2 rounded-2xl border p-2.5 ${z.enabled ? "border-cream-300 bg-cream-100" : "border-dashed border-cream-400 bg-cream-50 opacity-70"}`}>
              <button type="button" onClick={() => setEditing(z)} className="min-w-0 flex-1 text-left" aria-label={`Edit ${z.name}`}>
                <p className="truncate text-sm font-bold">{z.name} {!z.enabled && <span className="text-[10px] font-semibold text-ink-500">(off)</span>}</p>
                <p className="text-xs text-ink-500"><span className="font-semibold text-leaf-700">{formatPrice(z.fee)}</span> · {eta(z.etaMins)}{z.minOrder > 0 ? ` · min ${formatPrice(z.minOrder)}` : ""}</p>
              </button>
              {[[-1, ArrowUp, "Move up"], [1, ArrowDown, "Move down"]].map(([d, Icon, label]) => (
                <button key={label} type="button" disabled={(d < 0 && i === 0) || (d > 0 && i === zones.length - 1)} onClick={() => move(i, d)} aria-label={`${label}: ${z.name}`} className="flex h-9 w-9 items-center justify-center rounded-full hover:bg-cream-200 disabled:opacity-25"><Icon size={15} /></button>
              ))}
              <button type="button" onClick={() => setEditing(z)} aria-label={`Edit ${z.name}`} className="flex h-9 w-9 items-center justify-center rounded-full hover:bg-cream-200"><Pencil size={15} /></button>
            </li>
          ))}
        </ul>
        {zones.length === 0 && (
          <div className="rounded-2xl border border-dashed border-cream-400 bg-cream-100 p-4 text-center">
            <p className="text-sm font-bold">No areas yet: customers pay one flat fee</p>
            <p className="mt-1 text-xs text-ink-500">Add areas to charge by location and show estimated times.</p>
            <button type="button" onClick={() => set({ zones: DEMO_ZONES })} className="mt-2 text-xs font-bold text-leaf-700 underline underline-offset-4">Start from sample areas</button>
          </div>
        )}
        <button type="button" onClick={() => setEditing(BLANK)} className={`${btnGhost} mt-3 w-full`}><Plus size={16} /> Add delivery area</button>
      </div>

      <div className="mt-3 divide-y divide-cream-300">
        {zones.length === 0 && <Row title="Flat delivery fee" hint="Used when no areas are set. 0 = customer pays the rider."><NumberBox label="Flat delivery fee" prefix="₦" value={settings.deliveryFee} onChange={(v) => set({ deliveryFee: v })} /></Row>}
        <Row title="Free delivery from" hint="Items subtotal at or above this. 0 = never free."><NumberBox label="Free delivery threshold" prefix="₦" value={settings.freeDeliveryAbove} onChange={(v) => set({ freeDeliveryAbove: v })} /></Row>
      </div>

      <Field id="d-note" label="Note shown to customers" hint={`${settings.deliveryNote.length}/240: e.g. "Outside these areas? WhatsApp us."`}>
        <textarea id="d-note" rows={2} className={`${inputClass(false)} h-auto py-3`} value={settings.deliveryNote} onChange={(e) => set({ deliveryNote: e.target.value.slice(0, 240) })} />
      </Field>

      {editing && <ZoneSheet zone={editing} onSave={save} onDelete={(id) => { set({ zones: zones.filter((z) => z.id !== id) }); setEditing(null); }} onClose={() => setEditing(null)} />}
    </Section>
  );
}
</file>

<file path="src/components/merchant/settings/FeeSettings.jsx">
import { useState } from "react";
import { Receipt } from "lucide-react";
import { Badge, NumberBox, Row, Section, SwitchRow } from "../fields.jsx";
import { computeServiceFee } from "../../../lib/pricing.js";
import { formatPrice } from "../../../lib/format.js";

const SAMPLES = [1500, 5000, 10000, 25000];

/** The "Online payment fee" line customers see when paying with Paystack, with a live calculator. */
export default function FeeSettings({ settings, set }) {
  const f = settings.serviceFee;
  const [sample, setSample] = useState(9000);
  const patch = (p) => set({ serviceFee: { ...f, ...p } });

  return (
    <Section id="fees" icon={Receipt} title="Online payment fee" subtitle="A separate line at checkout so customers cover card/transfer charges." badge={<Badge tone={f.enabled ? "good" : "neutral"}>{f.enabled ? "Shown" : "Off"}</Badge>}>
      <div className="divide-y divide-cream-300">
        <SwitchRow title="Show a fee line for online payments" hint="Not added to WhatsApp orders until the customer pays online." checked={f.enabled} onChange={(v) => patch({ enabled: v })} />
        <Row title="Percentage" hint="Of items + delivery."><NumberBox label="Percentage" step suffix="%" value={f.percent} onChange={(v) => patch({ percent: Math.min(v, 10) })} /></Row>
        <Row title="Flat amount" hint="Added on top…"><NumberBox label="Flat amount" prefix="₦" value={f.flat} onChange={(v) => patch({ flat: Math.min(v, 5000) })} /></Row>
        <Row title="…only from" hint="Orders below this skip the flat amount."><NumberBox label="Flat amount applies from" prefix="₦" value={f.flatWaivedBelow} onChange={(v) => patch({ flatWaivedBelow: v })} /></Row>
        <Row title="Never more than" hint="Cap per order. 0 = no cap."><NumberBox label="Fee cap" prefix="₦" value={f.cap} onChange={(v) => patch({ cap: v })} /></Row>
      </div>

      <div className="surface-apricot mt-3 rounded-2xl p-4 text-sun-900">
        <p className="text-xs font-bold uppercase tracking-widest">Calculator</p>
        <div className="mt-2 flex items-center justify-between gap-3">
          <label htmlFor="fee-sample" className="text-sm font-semibold">Order total (items + delivery)</label>
          <NumberBox id="fee-sample" width="w-28" prefix="₦" value={sample} onChange={setSample} />
        </div>
        <p className="mt-2 flex items-baseline justify-between text-sm"><span>Customer pays fee</span><b className="font-display text-xl tabular-nums">{formatPrice(computeServiceFee(sample, f))}</b></p>
        <p className="flex items-baseline justify-between text-sm"><span>Customer total</span><b className="tabular-nums">{formatPrice(sample + computeServiceFee(sample, f))}</b></p>
        <ul className="mt-3 grid grid-cols-4 gap-1.5 text-center text-[11px]">
          {SAMPLES.map((n) => <li key={n} className="rounded-lg bg-white/40 px-1 py-1.5"><span className="block opacity-70">{formatPrice(n)}</span><b className="tabular-nums">+{formatPrice(computeServiceFee(n, f))}</b></li>)}
        </ul>
      </div>
      <p className="mt-2 text-[11px] text-ink-500">Defaults mirror a typical local-card structure. Check them against your own Paystack plan; Paystack&apos;s actual charge is deducted from what you receive, this line lets customers cover it.</p>
    </Section>
  );
}
